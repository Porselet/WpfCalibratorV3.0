<Window x:Class="WpfCalibrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🎛️ Универсальный Калибратор STM32"
        Height="750"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#000000">

    <Window.Resources>
        <!-- 1. Шаблон для отображения СКАЛЯРА (одиночного значения) -->
        <DataTemplate x:Key="ScalarTextBoxTemplate">
            <Border BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10" Background="#1A1A1A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="#00FF00" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Comment}" Foreground="#888888" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <!-- Поле ввода значения калибровки -->
                    <TextBox Grid.Column="1" Text="0" Background="#222222" Foreground="White" BorderBrush="#555555" 
                             Padding="5" VerticalAlignment="Center" HorizontalContentAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 2. Шаблон для отображения МАТРИЦЫ / ТАБЛИЦЫ -->
        <DataTemplate x:Key="MatrixTableTemplate">
            <Border BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15" Background="#1E1E1E">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" Foreground="#00E5FF" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Comment}" Foreground="#888888" FontSize="11" Margin="0,2,0,5"/>
                    <TextBlock Foreground="#FF9100" FontSize="10" Margin="0,0,0,5">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Размерность: {0} x {1}">
                                <Binding Path="Rows"/>
                                <Binding Path="Cols"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- Заглушка под таблицу калибровок (можно будет заменить на DataGrid) -->
                    <Border Background="#111111" BorderBrush="#333333" BorderThickness="1" Height="80" CornerRadius="2">
                        <TextBlock Text="[ Сетка значений матрицы ]" Foreground="#555555" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Основная сетка с тремя колонками -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Левая панель (Навигация) -->
            <ColumnDefinition Width="*"/>
            <!-- Central Panel (Редактор) -->
            <ColumnDefinition Width="300"/>
            <!-- Правая панель (Приборы) -->
        </Grid.ColumnDefinitions>

        <!-- Левая панель: Дерево навигации -->
        <Border Grid.Column="0"
              Background="#111111"
              BorderBrush="#444444"
              BorderThickness="0,0,2,0"
              Padding="15">
            <StackPanel>
                <TextBlock Text="🌲 ДЕРЕВО МОДЕЛЕЙ"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#FFFF00"
                       Margin="0,0,0,15"/>

                <!-- Сюда будет привязано дерево моделей -->
                <TreeView ItemsSource="{Binding DiscoveredDevices}"
                     Background="#111111"
                     BorderThickness="0"
                     SelectedItemChanged="TreeView_SelectedItemChanged"/>

                <!-- Кнопки внизу панели -->
                <StackPanel Orientation="Horizontal"
                             Margin="0,15,0,0">
                    <Button Content="💾 СОХРАНИТЬ ВО FLASH"
                          FontSize="18"
                          FontWeight="Bold"
                          Background="#2E7D32"
                          Foreground="White"
                          Padding="12"
                          Margin="0,0,10,0"/>

                    <Button Content="⚙️ НАСТРОЙКА ЭКРАНА"
                          FontSize="18"
                          FontWeight="Bold"
                          Background="#7B1FA2"
                          Foreground="White"
                          Padding="12"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Центральная панель: Редактор переменных -->
        <Border Grid.Column="1"
              Background="#111111"
              BorderBrush="#444444"
              BorderThickness="2,0,2,0"
              Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Здесь будут отображаться переменные -->
                    <ItemsControl ItemsSource="{Binding ParameterVariables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Шаблон для отображения таблицы или скаляра -->
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <!-- По умолчанию показываем таблицу -->
                                            <Setter Property="ContentTemplate" Value="{StaticResource MatrixTableTemplate}"/>
                                            <!-- Если это скаляр, показываем TextBox -->
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TotalElements}" Value="1">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ScalarTextBoxTemplate}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Правая панель: Приборная панель -->
        <Border Grid.Column="2"
              Background="#111111"
              BorderBrush="#444444"
              BorderThickness="2,0,0,0"
              Padding="10">
            <!-- Сюда будут добавляться виджеты -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок панели -->
                <TextBlock Text="🧠 ПРИБОРНАЯ ПАНЕЛЬ"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#FFFF00"
                       Margin="0,0,0,10"/>

                <!-- Контейнер для виджетов -->
                <StackPanel Grid.Row="1"
                         Orientation="Vertical"
                         Background="#111111">
                    <!-- Виджеты будут добавляться сюда -->
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
