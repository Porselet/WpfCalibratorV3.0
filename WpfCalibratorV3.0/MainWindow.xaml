<Window x:Class="WpfCalibrator.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:views="clr-namespace:WpfCalibrator.Views"
        Title="🎛️ Универсальный Калибратор STM32"
        PreviewKeyDown="GlobalWindow_PreviewKeyDown"
        Height="750" Width="1200" WindowStartupLocation="CenterScreen" Background="#000000">
    <Window.InputBindings>
        <!-- Привязываем Ctrl+B напрямую к нашей новой команде бэкэнда -->
        <KeyBinding Modifiers="Ctrl" Key="B" Command="{Binding ToggleLeftPanelCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Левая колонка подстроится под размер панели, а при скрытии схлопнется в 0 -->
            <ColumnDefinition Width="Auto"/>
            <!-- Центральная колонка с холстом WorkspaceCanvas займет всё оставшееся место -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Модуль левого дерева с автоматическим скрытием через XAML триггер -->
        <views:TreeViewPanel Grid.Column="0" x:Name="LeftPanel" Width="300"
                             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
            <views:TreeViewPanel.Style>
                <Style TargetType="UserControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Если флаг в ОЗУ переключился в false -> полностью скрываем панель из макета! -->
                        <DataTrigger Binding="{Binding IsLeftPanelVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </views:TreeViewPanel.Style>
        </views:TreeViewPanel>



        <!-- Подключаем модуль свободного холста -->
        <!-- Центральная колонка главного окна с динамическими экранами -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Строка для горизонтальных вкладок -->
                <RowDefinition Height="*"/>
                <!-- Строка для холста WorkspaceCanvas -->
            </Grid.RowDefinitions>

            <!-- ГОРИЗОНТАЛЬНАЯ ПАНЕЛЬ РАБОЧИХ ЭКРАНОВ (ВКЛАДОК) -->
            <!-- ГОРИЗОНТАЛЬНАЯ ПАНЕЛЬ С УПРАВЛЕНИЕМ ЭКРАНАМИ -->
            <!-- ГОРИЗОНТАЛЬНАЯ ПАНЕЛЬ С УПРАВЛЕНИЕМ ЭКРАНАМИ И ИНСТРУМЕНТАМИ -->
            <Grid Grid.Row="0" Background="#151515">
                <!-- Левая часть: вкладки экранов -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <!-- СПИСОК ВКЛАДОК -->
                    <!-- КНОПКА-ПЕРЕКЛЮЧАТЕЛЬ ВИДИМОСТИ НАВИГАЦИИ -->
                    <ToggleButton IsChecked="{Binding IsLeftPanelVisible, Mode=TwoWay}"
                              Width="30" Height="26"
                              Background="#333333" Foreground="#00E5FF"
                              FontWeight="Bold" FontSize="14" FontFamily="Consolas"
                              Margin="5,0,0,0" Cursor="Hand"
                              ToolTip="Скрыть/Показать панель навигации (Ctrl+B)">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Content" Value="◀"/>
                                <Style.Triggers>
                                    <!-- Когда флаг сброшен (панель скрыта) — меняем стрелку вправо! -->
                                    <Trigger Property="IsChecked" Value="False">
                                        <Setter Property="Content" Value="▶"/>
                                        <Setter Property="Foreground" Value="#FF9100"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <ListBox ItemsSource="{Binding LayoutNames}" 
                             SelectedItem="{Binding CurrentLayoutName}"
                             Background="Transparent" 
                             BorderThickness="0"
                             Padding="5,2">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="5,2">
                                    <TextBlock Text="{Binding}" 
                                               Foreground="White" 
                                               FontSize="14" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,8,0"
                                               FontFamily="Consolas"/>
                                    <Button Content="×" 
                                            Foreground="#FF5555" 
                                            Background="Transparent" 
                                            BorderThickness="0" 
                                            FontSize="14"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"
                                            Command="{Binding DataContext.DeleteLayoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ИНЖЕНЕРНАЯ КНОПКА ДОБАВЛЕНИЯ НОВОГО ЭКРАНА [ + ] -->
                    <Button Content="+" 
                            Width="30" Height="26"
                            Background="#2E7D32" 
                            Foreground="White" 
                            FontWeight="Bold" 
                            FontSize="16"
                            FontFamily="Consolas"
                            Margin="5,0,0,0"
                            Cursor="Hand"
                            ToolTip="Создать новый рабочий экран"
                            Command="{Binding AddLayoutCommand}"/>
                </StackPanel>

                <!-- ПРАВАЯ ЧАСТЬ: ИНЖЕНЕРНЫЙ ВЫЗОВ UART СНИФФЕРА -->
                <Button Content="⚡ UART Monitor" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Margin="0,0,10,0" 
                        Padding="8,3"
                        Background="#333333" 
                        Foreground="#00FF00" 
                        FontFamily="Consolas" 
                        FontWeight="Bold"
                        FontSize="12"
                        Cursor="Hand"
                        ToolTip="Открыть мониторинг сырых пакетов обмена"
                        Click="MenuUartMonitor_Click"/>
            </Grid>

            <!-- ХОЛСТ СВОБОДНОГО ПОЗИЦИОНИРОВАНИЯ (С явным пробросом DataContext главного окна) -->
            <views:WorkspaceCanvas x:Name="CentralCanvas" 
                       Grid.Row="1" 
                       DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"/>
        </Grid>

    </Grid>
</Window>