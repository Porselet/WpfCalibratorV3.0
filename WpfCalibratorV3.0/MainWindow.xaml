<Window x:Class="WpfCalibrator.MainWindow"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:views="clr-namespace:WpfCalibrator.Views"
        Title="🎛️ Универсальный Калибратор STM32"
        Height="750" Width="1200" WindowStartupLocation="CenterScreen" Background="#000000">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <!-- Левая колонка -->
            <ColumnDefinition Width="*"/>
            <!-- Центральная колонка -->
        </Grid.ColumnDefinitions>

        <!-- Подключаем модуль левого дерева -->
        <views:TreeViewPanel x:Name="LeftPanel" Grid.Column="0"/>

        <!-- Подключаем модуль свободного холста -->
        <views:WorkspaceCanvas x:Name="CentralCanvas" Grid.Column="1"/>
    </Grid>
</Window>