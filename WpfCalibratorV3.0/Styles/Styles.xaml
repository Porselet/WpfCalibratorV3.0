<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:WpfCalibrator.ViewModels">

    <!-- КИСТИ (Объявляем в самом начале, чтобы стили ниже могли их видеть) -->
    <SolidColorBrush x:Key="DarkGrayBrush" Color="#222222"/>
    <SolidColorBrush x:Key="HighlightBrush" Color="#00FF00"/>

    <!-- Базовые стили для текста -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <!-- Стиль для заголовков блоков -->
    <Style x:Key="BlockHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFFF00"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Стиль для ячеек таблицы -->
    <Style x:Key="CellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="{StaticResource DarkGrayBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#444444"/>

        <!-- Подсветка активной ячейки -->
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="{StaticResource HighlightBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
