<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="clr-namespace:WpfCalibrator.ViewModels"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:media3d="clr-namespace:System.Windows.Media.Media3D;assembly=PresentationCore"
 
    
    >


    <!-- ====================================================================== -->
    <!-- ГЛОБАЛЬНЫЕ СТИЛИ (Компилируются в первую очередь, видны всем шаблонам) -->
    <!-- ====================================================================== -->
    <!-- ВОССТАНОВЛЕНИЕ: Стиль для заголовков блоков левого дерева переменных TreeView -->
    <Style x:Key="LocalBlockHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFA500"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="5,5,5,2"/>
    </Style>
    <!-- 1. СТИЛЬ ДЛЯ РАМОК ЯЧЕЕК ТАБЛИЦЫ С ПОДДЕРЖКОЙ КУРСОРНОГО ВЫДЕЛЕНИЯ -->
    <Style x:Key="MatrixCellBorderStyle" TargetType="Border">
        <!-- Для 5х6 ячейки будут растягиваться, а для 32х32 никогда не сожмутся меньше этих цифр! -->
        <Setter Property="MinWidth" Value="45"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Background" Value="#222222"/>
        <Setter Property="BorderBrush" Value="#444444"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <!-- Живой неоновый прицел режимной точки двигателя -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="#00FF00"/>
                <Setter Property="BorderBrush" Value="#00FF00"/>
            </DataTrigger>

            <!-- Синий курсор выделения ячейки инженером -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="#007ACC"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>

            <!-- КОМБО! Если курсор навигации совпал с живым прицелом мотора -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsActive}" Value="True"/>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#00FF00"/>
                <Setter Property="BorderBrush" Value="#007ACC"/>
                <Setter Property="BorderThickness" Value="2"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 2. СТИЛЬ ДЛЯ ТЕКСТА ВНУТРИ ЯЧЕЕК С АВТОФОКУСОМ (MoTeC-Style) -->
    <Style x:Key="MatrixCellTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <!-- Жирный черный текст на неоновом фоне режимной точки -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>

            <!-- МАГИЯ АВТОФОКУСА: TextBox принудительно забирает фокус ввода -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding Parent.IsEditing}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FocusManager.FocusedElement" Value="{Binding RelativeSource={RelativeSource Self}}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <!-- ====================================================================== -->
    <!-- ВИЗУАЛЬНЫЕ ШАБЛОНЫ ПРИБОРОВ (ЧИТАЮТ СТИЛИ СВЕРХУ СТАБИЛЬНО) -->
    <!-- ====================================================================== -->

    <!-- ШАБЛОН ОДИНОЧНОГО ПАРАМЕТРА (СКАЛЯРА С ПОДДЕРЖКОЙ РЕСАЙЗА) -->
    <DataTemplate x:Key="ScalarTextBoxTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Задаем базовые пропорции, от которых Viewbox будет увеличивать контент -->
                <Grid Width="260" Height="110">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Текст названия параметра -->
                    <TextBlock Grid.Column="0" 
                               Text="{Binding DataSource.Name}" 
                               Foreground="#00FF00" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               FontFamily="Consolas" 
                               VerticalAlignment="Center" 
                               Margin="10,0"/>

                    <!-- Поле ввода TextBox -->
                    <!-- Поле ввода TextBox скаляра (Бесфокусный режим) -->
                    <TextBox Grid.Column="1" 
                             Text="{Binding DataSource.CurrentValueText, Mode=OneWay}" 
                             Focusable="False"
                             IsReadOnly="True"
                             Background="#222222" 
                             Foreground="White" 
                             FontFamily="Consolas" 
                             FontSize="22" 
                             Width="120" 
                             Height="36" 
                             VerticalAlignment="Center" 
                             HorizontalContentAlignment="Center" 
                             VerticalContentAlignment="Center" 
                             Margin="10,0"/>

                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>
    <!-- ШАБЛОН 3D-ТАБЛИЦЫ (ВЕКТОРНЫЙ И ЧИСТЫЙ) -->
    <!-- ШАБЛОН ДЛЯ ОТОБРАЖЕНИЯ ТАБЛИЦ (МАТРИЦ И ВЕКТОРОВ С ОСЯМИ) -->
    <!-- ШАБЛОН ДЛЯ ОТОБРАЖЕНИЯ ТАБЛИЦ (МАТРИЦ И ВЕКТОРОВ С ОСЯМИ) -->
    <!-- ШАБЛОН ДЛЯ ОТОБРАЖЕНИЯ ТАБЛИЦ (МАТРИЦ И ВЕКТОРОВ С ОСЯМИ) -->
    <!-- ШАБЛОН ДЛЯ ОТОБРАЖЕНИЯ ТАБЛИЦ (МАТРИЦ И ВЕКТОРОВ С ОСЯМИ) -->
    <!-- ШАБЛОН ДЛЯ ОТОБРАЖЕНИЯ ТАБЛИЦ (МАТРИЦ И ВЕКТОРОВ С ОСЯМИ) -->
    <!-- ШАБЛОН ДЛЯ ОТОБРАЖЕНИЯ ТАБЛИЦ -->
    <!-- ШАБЛОН ДЛЯ ОТОБРАЖЕНИЯ ТАБЛИЦ (МАТРИЦ И ВЕКТОРОВ С ОСЯМИ) -->
    <DataTemplate x:Key="MatrixTableTemplate">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#111111">
            <Grid Margin="10">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Height" Value="Auto"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataSource.Rows}" Value="1">
                                <Setter Property="Height" Value="75"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <!-- 🔥 ИСПРАВЛЕНО: Для колонок используем строго Width! -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Ширина боковой оси Y подстроится под текст -->
                    <ColumnDefinition Width="*"/>
                    <!-- Матрица займет всё оставшееся место -->
                </Grid.ColumnDefinitions>

                <!-- 1. НАЗВАНИЕ ТАБЛИЦЫ -->
                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding DataSource.Name}" 
                           Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="35,0,0,5"/>

                <!-- 2. ВЕРХНЯЯ ОСЬ Х -->
                <ItemsControl Grid.Row="1" Grid.Column="1" 
                              x:Name="X_Axis_Items"
                              ItemsSource="{Binding DataSource.BoundAxisX.MatrixCells}" 
                              Margin="1,0,0,2">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="{Binding DataSource.Cols}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252525" BorderBrush="#333333" BorderThickness="1" Margin="1,0">
                                <TextBlock Text="{Binding ValueText}" Foreground="#FFFF00" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. БОКОВАЯ ОСЬ Y -->
                <ItemsControl Grid.Row="2" Grid.Column="0" 
                              ItemsSource="{Binding DataSource.BoundAxisY.MatrixCells}" 
                              Margin="0,1,2,1" Width="32">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DataSource.Rows}" Columns="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252525" BorderBrush="#333333" BorderThickness="1" Margin="0,1">
                                <TextBlock Text="{Binding ValueText}" Foreground="#FFFF00" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 4. ОСНОВНАЯ КАЛИБРОВОЧНАЯ МАТРИЦА (РЕЗИНОВАЯ + АВТО-СКРОЛЛ) -->
                <!-- 4. ОСНОВНАЯ КАЛИБРОВОЧНАЯ МАТРИЦА (РЕЗИНОВАЯ + АВТО-СКРОЛЛ) -->
                <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DataSource.MatrixCells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DataSource.Rows}" Columns="{Binding DataSource.Cols}"
                                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MatrixCellBorderStyle}" MinWidth="50" MinHeight="24" Margin="0.5">
                                <!-- 🔥 Обернули ТОЛЬКО текст в индивидуальный Viewbox! 
                     Теперь шрифт резиновый внутри каждой ячейки по отдельности, 
                     а общая геометрия UniformGrid защищена скроллом! -->
                                <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBox Text="{Binding ValueText, Mode=TwoWay}"
                             Style="{StaticResource MatrixCellTextBoxStyle}"
                             FontWeight="Bold" Foreground="#FFFFFF" Margin="2"/>
                                </Viewbox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


            </Grid>
        </ScrollViewer>
    </DataTemplate>

    <!-- ====================================================================== -->
    <!-- ВОССТАНОВЛЕНИЕ ОСТАЛЬНЫХ ШАБЛОНОВ ПРИБОРОВ (ЧТОБЫ УБРАТЬ ОШИБКИ)       -->
    <!-- ====================================================================== -->

    <!-- ШАБЛОН ЦИФРОВОГО ДАТЧИКА (Digital) -->
    <!-- ШАБЛОН ЦИФРОВОГО ДАТЧИКА (Digital С ПОДДЕРЖКОЙ АЛАРМОВ СИГНАЛОВ) -->
    <!-- ШАБЛОН ЦИФРОВОГО ДАТЧИКА (Digital: БЕЗ ДУБЛИРОВАНИЯ ИМЕНИ, МАКСИМАЛЬНЫЙ ШРИФТ) -->
    <DataTemplate x:Key="WidgetDigitalTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Базовый контейнер. Увеличиваем высоту шрифта за счет удаления лишних строк -->
                <Grid Width="200" Height="80">

                    <!-- РАМКА С АЛАРМАМИ ПОДЛОЖКИ -->
                    <Border x:Name="SensorBorder" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#151515"/>
                                <Style.Triggers>
                                    <!-- УМНЫЙ МУЛЬТИТРИГГЕР: Краснеем, только если аларм активен И это разрешено в настройках! -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                            <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#990000"/>
                                        <Setter Property="BorderBrush" Value="#FF0000"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Border.Style>

                        <!-- ЧИСТЫЕ ГИГАНТСКИЕ ЦИФРЫ (Занимают 100% пространства) -->
                        <TextBlock x:Name="ValueText" 
                                   Text="{Binding DataSource.CurrentValue, StringFormat={}{0:F1}}" 
                                   FontSize="48" FontWeight="Bold" FontFamily="Consolas" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#007ACC"/>
                                    <Style.Triggers>
                                        <!-- Текст белеет на красном фоне только при подтверждении флага -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                                <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Foreground" Value="White"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>

                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>


    <!-- ШАБЛОН ГОРИЗОНТАЛЬНОГО СЛАЙДЕРА (ЧИСТАЯ ШКАЛА, РИСКИ ЛИМИТОВ И АЛАРМ ФОНА) -->
    <DataTemplate x:Key="WidgetSliderTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Компактный, узкий прибор строго под шкалу -->
                <Grid Width="260" Height="45">

                    <!-- ОБЩАЯ РАМКА ПРИБОРА С АЛАРМОМ НА УРОВНЕ ФОНА ЗАДНИКА -->
                    <Border x:Name="SliderBorder" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <!-- Стандартный гоночный серый фон -->
                                <Setter Property="Background" Value="#151515"/>
                                <Style.Triggers>
                                    <!-- Слайдер тоже проверяет разрешение на красный фон задника -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                            <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#990000"/>
                                        <Setter Property="BorderBrush" Value="#FF0000"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>

                            </Style>
                        </Border.Style>

                        <!-- Контейнер для наложения шкал и рисок друг на друга -->
                        <!-- Контейнер для наложения шкал и двух рисок друг на друга -->
                        <!-- Контейнер для наложения шкал и двух рисок друг на друга -->
                        <!-- ИСПРАВЛЕНО: Полностью удалены MultiBinding и конвертеры! -->
                        <!-- Контейнер для наложения шкал и треугольников друг на друга -->
                        <!-- Контейнер для наложения барграфа и треугольников лимитов друг на друга -->
                        <Grid Margin="15,0" Width="230">

                            <!-- 1. РАСТУЩИЙ ВБОК ПРЯМОУГОЛЬНИК (Полноценный ProgressBar вместо Slider) -->
                            <ProgressBar Minimum="{Binding DataSource.ScaleMin}" 
                                         Maximum="{Binding DataSource.ScaleMax}" 
                                         Value="{Binding DataSource.CurrentValue}"
                                         Height="14" VerticalAlignment="Center"
                                         Background="#222222" BorderThickness="1" BorderBrush="#333333">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <!-- Стандартный синий неоновый MoTeC цвет заполнения -->
                                        <Setter Property="Foreground" Value="#007ACC"/>
                                        <Style.Triggers>
                                            <!-- При аларме заполняющийся прямоугольник становится белым для контраста на красном фоне -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                                    <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="White"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <!-- 2. ДВА КРАСНЫХ ХОВЕР-ТРЕУГОЛЬНИКА СВЕРХУ ШКАЛЫ БАРГРАФА -->
                            <!-- Используем наши готовые, отлаженные C#-координаты MinAlarmX и MaxAlarmX -->
                            <Canvas Width="230" Height="45" VerticalAlignment="Stretch" HorizontalAlignment="Left">

                                <!-- ТРЕУГОЛЬНИК МИНИМУМА (Смотрит острием вниз на растущую полосу) -->
                                <Polygon Points="0,0 10,0 5,8" Fill="#FF0000" VerticalAlignment="Top" Canvas.Top="4">
                                    <Polygon.RenderTransform>
                                        <TranslateTransform X="{Binding MinAlarmX}"/>
                                    </Polygon.RenderTransform>
                                </Polygon>

                                <!-- ТРЕУГОЛЬНИК МАКСИМУМА -->
                                <Polygon Points="0,0 10,0 5,8" Fill="#FF0000" VerticalAlignment="Top" Canvas.Top="4">
                                    <Polygon.RenderTransform>
                                        <TranslateTransform X="{Binding MaxAlarmX}"/>
                                    </Polygon.RenderTransform>
                                </Polygon>

                            </Canvas>
                        </Grid>

                    </Border>
                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>


    <!-- ШАБЛОН ВЕРТИКАЛЬНОГО СЛАЙДЕРА (ЧИСТЫЙ СТОЛБИК, СТРЕЛКИ СЛЕВА И АЛАРМ ФОНА) -->
    <DataTemplate x:Key="WidgetVerticalSliderTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Компактный вертикальный прибор MoTeC-Style -->
                <Grid Width="75" Height="210">

                    <!-- РАМКА С АЛАРМОМ НА УРОВНЕ ФОНА ЗАДНИКА -->
                    <Border x:Name="SliderBorder" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#151515"/>
                                <Style.Triggers>
                                    <!-- Слайдер тоже проверяет разрешение на красный фон задника -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                            <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#990000"/>
                                        <Setter Property="BorderBrush" Value="#FF0000"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!-- Контейнер для наложения шкал и боковых треугольников (высота трека зажата в 180 пикселей) -->
                        <!-- Контейнер для наложения вертикального барграфа и треугольников лимитов друг на друга -->
                        <Grid Margin="0,15" Height="180">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <!-- Зона для треугольников слева -->
                                <ColumnDefinition Width="*"/>
                                <!-- Зона самого вертикального барграфа -->
                            </Grid.ColumnDefinitions>

                            <!-- 1. РАСТУЩИЙ СНИЗУ ВВЕРХ СТОЛБИК (ProgressBar с вертикальной ориентацией) -->
                            <ProgressBar Grid.Column="1"
                                         Orientation="Vertical"
                                         Minimum="{Binding DataSource.ScaleMin}" 
                                         Maximum="{Binding DataSource.ScaleMax}" 
                                         Value="{Binding DataSource.CurrentValue}" 
                                         Width="14" HorizontalAlignment="Center"
                                         Background="#222222" BorderThickness="1" BorderBrush="#333333">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar">
                                        <!-- Стандартный синий неоновый MoTeC цвет заполнения -->
                                        <Setter Property="Foreground" Value="#007ACC"/>
                                        <Style.Triggers>
                                            <!-- При активном аларме бегущий столбик становится белым для контраста на красном фоне -->
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                                    <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="White"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>

                            <!-- 2. ДВА КРАСНЫХ ХОВЕР-ТРЕУГОЛЬНИКА СЛЕВА ОТ СТОЛБИКА БАРГРАФА -->
                            <!-- Canvas растянут ровно по высоте шкалы (180 пикселей) -->
                            <Canvas Grid.Column="0" Width="20" Height="180" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

                                <!-- ТРЕУГОЛЬНИК МИНИМУМА (Смотрит острием вправо на растущий столбик) -->
                                <Polygon Points="0,0 0,10 8,5" Fill="#FF0000" HorizontalAlignment="Left" Canvas.Left="8">
                                    <Polygon.RenderTransform>
                                        <!-- Смещаем по оси Y на рассчитанные в C# пиксели MinAlarmY -->
                                        <TranslateTransform Y="{Binding MinAlarmY}"/>
                                    </Polygon.RenderTransform>
                                </Polygon>

                                <!-- ТРЕУГОЛЬНИК МАКСИМУМА -->
                                <Polygon Points="0,0 0,10 8,5" Fill="#FF0000" HorizontalAlignment="Left" Canvas.Left="8">
                                    <Polygon.RenderTransform>
                                        <TranslateTransform Y="{Binding MaxAlarmY}"/>
                                    </Polygon.RenderTransform>
                                </Polygon>

                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>



    <!-- ШАБЛОН КРУГЛОГО СТРЕЛОЧНОГО ПРИБОРА 270° (ВОССТАНОВЛЕННЫЙ, СИММЕТРИЯ 8-4 ЧАСА) -->
    <DataTemplate x:Key="WidgetGaugeTemplate">
        <DataTemplate.Resources>
            <!-- Выносим стиль корпуса, гарантируя ЕДИНСТВЕННЫЙ Child внутри Border -->
            <Style x:Key="GaugeBodyBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#121212"/>
                <Setter Property="BorderBrush" Value="#007ACC"/>
                <Setter Property="BorderThickness" Value="1.5"/>
                <Setter Property="CornerRadius" Value="100"/>
                <Style.Triggers>
                    <!-- МУЛЬТИТРИГГЕР: Задник монолитно багровеет при аларме, если разрешено -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                            <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="#990000"/>
                        <Setter Property="BorderBrush" Value="#FF0000"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </DataTemplate.Resources>

        <Grid Margin="5">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Прибор строго круглый (Width="200" Height="200") -->
                <Grid Width="200" Height="200">

                    <!-- КОРПУС ПРИБОРА -->
                    <Border x:Name="GaugeBody" Style="{StaticResource GaugeBodyBorderStyle}">
                        <Grid>

                            <!-- ТЕКСТ НАЗВАНИЯ ДАТЧИКА (Блеклый, по центру в верхней части полусферы) -->
                            <TextBlock Text="{Binding DataSource.Name}" Foreground="Gray" FontSize="11" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0" Opacity="0.6"/>

                            <!-- ЦИФРОВОЙ ДУБЛИКАТОР ЗНАЧЕНИЯ (Крупный, по центру в нижней части полусферы) -->
                            <TextBlock Text="{Binding DataSource.CurrentValue, StringFormat={}{0:F1}}" FontSize="24" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,35">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                                    <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- СЕКТОРНАЯ ДУГА ШКАЛЫ ПРИБОРА (МОНОЛИТНАЯ, ЦЕНТРИРОВАННАЯ 200х200) -->
                            <Path Stroke="#333333" StrokeThickness="3" 
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Width="200" Height="200" Stretch="None"
                                  Data="M 35,137.5 A 75,75 0 1 1 165,137.5"/>

                            <!-- КРАСНЫЙ ТРЕУГОЛЬНИК МИНИМАЛЬНОГО АЛАРМА (Gauge Min) -->
                            <Polygon Points="96,15 104,15 100,25" Fill="#FF0000">
                                <Polygon.RenderTransform>
                                    <RotateTransform Angle="{Binding GaugeMinAlarmAngle}" CenterX="100" CenterY="100"/>
                                </Polygon.RenderTransform>
                            </Polygon>

                            <!-- КРАСНЫЙ ТРЕУГОЛЬНИК МАКСИМАЛЬНОГО АЛАРМА (Gauge Max) -->
                            <Polygon Points="96,15 104,15 100,25" Fill="#FF0000">
                                <Polygon.RenderTransform>
                                    <RotateTransform Angle="{Binding GaugeMaxAlarmAngle}" CenterX="100" CenterY="100"/>
                                </Polygon.RenderTransform>
                            </Polygon>

                            <!-- ЖИВАЯ НЕОНОВАЯ СТРУКТУРНАЯ СТРЕЛКА ПРИБОРА -->
                            <Line X1="100" Y1="100" X2="100" Y2="22" StrokeThickness="3.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Line.Style>
                                    <Style TargetType="Line">
                                        <Setter Property="Stroke" Value="#007ACC"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                                    <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Stroke" Value="White"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Line.Style>
                                <Line.RenderTransform>
                                    <RotateTransform Angle="{Binding GaugeValueAngle}" CenterX="100" CenterY="100"/>
                                </Line.RenderTransform>
                            </Line>

                            <!-- Центральный изящный колпачок стрелки -->
                            <Ellipse Width="12" Height="12" Fill="#121212" Stroke="#007ACC" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Grid>
                    </Border>
                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>





    <!-- ШАБЛОН ДУГОВОГО ПРИБОРА (ЧИСТАЯ ЛИНЕЙКА ИЗ 10 ОБЪЕМНЫХ СВЕТОДИОДОВ БЕЗ ТЕКСТА) -->
