<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="clr-namespace:WpfCalibrator.ViewModels">

    <!-- Базовый стиль заголовков панелей -->
    <Style x:Key="LocalBlockHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFFF00"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <!-- 1. ШАБЛОН: Цифровой дисплей телеметрии (Чтение через DataSource) -->
    <DataTemplate x:Key="WidgetDigitalTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DataSource.Name}" Foreground="#00E5FF" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                <TextBlock Text="{Binding DataSource.Comment}" Foreground="#666666" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding DataSource.CurrentValue, StringFormat='{}{0:F2}'}" Foreground="#00E5FF" FontSize="26" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
    </DataTemplate>

    <!-- 2. ШАБЛОН: Скалярный параметр (Редактирование через DataSource) -->
    <DataTemplate x:Key="ScalarTextBoxTemplate">
        <Grid Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- Левая колонка для текста -->
                <ColumnDefinition Width="Auto"/>
                <!-- Правая колонка точно под размер TextBox -->
            </Grid.ColumnDefinitions>

            <!-- НАЗВАНИЕ И ОПИСАНИЕ ПАРАМЕТРА (СТРОГО В КОЛОНКЕ 0) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock Text="{Binding DataSource.Name}" 
                           Foreground="#00FF00" 
                           FontSize="14" 
                           FontWeight="Bold" 
                           FontFamily="Consolas"/>
                <TextBlock Text="{Binding DataSource.Comment}" 
                           Foreground="#888888" 
                           FontSize="11" 
                           TextWrapping="Wrap" 
                           FontFamily="Consolas"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- ТЕКСТОВОЕ ПОЛЕ ВВОДА (СТРОГО В КОЛОНКЕ 1) -->
            <TextBox Grid.Column="1"
                     x:Name="ScalarInput"
                     Text="{Binding DataSource.CurrentValue, UpdateSourceTrigger=LostFocus, StringFormat='{}{0:F3}'}"
                     Background="#222222" 
                     Foreground="White" 
                     BorderBrush="#555555" 
                     BorderThickness="1"
                     FontSize="14" 
                     FontFamily="Consolas" 
                     Width="80" Height="24"
                     HorizontalContentAlignment="Center" 
                     VerticalContentAlignment="Center"
                     VerticalAlignment="Center">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" 
                                Command="{Binding DataContext.SaveLayoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </TextBox.InputBindings>
            </TextBox>
        </Grid>
    </DataTemplate>
    <!-- 3. ШАБЛОН: Многомерная таблица LUT (Сетка через DataSource.Cells) -->

    <DataTemplate x:Key="MatrixTableTemplate">
        <Grid Margin="5">
            <Grid.Resources>
                <!-- ЛОКАЛЬНЫЙ СТИЛЬ ДЛЯ ЯЧЕЕК ТАБЛИЦЫ -->
                <!-- ОБНОВЛЕННЫЙ ЛОКАЛЬНЫЙ СТИЛЬ ДЛЯ ЯЧЕЕК ТАБЛИЦЫ С ПОДДЕРЖКОЙ КУРСОРНОГО ВЫДЕЛЕНИЯ -->
                <Style x:Key="MatrixCellBorderStyle" TargetType="Border">
                    <Setter Property="Background" Value="#222222"/>
                    <Setter Property="BorderBrush" Value="#444444"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Style.Triggers>
                        <!-- ТРИГГЕР 1: Живой неоновый прицел режимной точки двигателя -->
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="#00FF00"/>
                            <Setter Property="BorderBrush" Value="#00FF00"/>
                        </DataTrigger>

                        <!-- ТРИГГЕР 2: Синий курсор выделения ячейки инженером -->
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="#007ACC"/>
                            <Setter Property="BorderThickness" Value="2"/>
                            <!-- Делаем рамку толще, чтобы её было четко видно -->
                        </DataTrigger>

                        <!-- ТРИГГЕР 3: КОМБО! Если курсор навигации совпал с живым прицелом мотора -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsActive}" Value="True"/>
                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Background" Value="#00FF00"/>
                            <Setter Property="BorderBrush" Value="#007ACC"/>
                            <!-- Синяя рамка поверх неонового фона -->
                            <Setter Property="BorderThickness" Value="2"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>


                <!-- СТИЛЬ ДЛЯ ТЕКСТА ВНУТРИ ЯЧЕЕК -->
                <!-- СТИЛЬ ДЛЯ ТЕКСТА ВНУТРИ ЯЧЕЕК С АВТОФОКУСОМ (MoTeC-Style) -->
                <!-- СТИЛЬ ДЛЯ ТЕКСТА ВНУТРИ ЯЧЕЕК (Очищен от конфликтов фокуса) -->
                <Style x:Key="MatrixCellTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Style.Triggers>
                        <!-- Если ячейка активна по телеметрии (зеленый неон) -->
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Foreground" Value="Black"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Шапка -->
                <RowDefinition Height="Auto"/>
                <!-- Ось X -->
                <RowDefinition Height="*"/>
                <!-- Сетка + Ось Y -->
            </Grid.RowDefinitions>

            <!-- ШАПКА ТАБЛИЦЫ -->
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DataSource.Name}" Foreground="#FFA500" FontWeight="Bold" Margin="0,0,10,0" FontFamily="Consolas"/>
                    <TextBlock Foreground="Gray" FontFamily="Consolas">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Размерность: {0} x {1}">
                                <Binding Path="DataSource.Rows"/>
                                <Binding Path="DataSource.Cols"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <Button Content="⚙" 
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="24" Height="20"
                        Background="#333333" Foreground="#FFA500" FontWeight="Bold" 
                        BorderThickness="1" BorderBrush="#555555" Cursor="Hand"
                        Command="{Binding DataContext.OpenTableSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>

            <!-- ВЫВОД ЗНАЧЕНИЙ ОСИ X (ИСПРАВЛЕНО: MatrixCells вместо Cells) -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding DataSource.BoundAxisX.MatrixCells}" Margin="35,0,0,2">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="{Binding DataSource.Cols}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#252525" BorderBrush="#333333" BorderThickness="1" Margin="1,0">
                            <TextBlock Text="{Binding ValueText}" Foreground="#FFFF00" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- НИЖНЯЯ ЗОНА: ОСЬ Y И МАТРИЦА -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ВЫВОД ЗНАЧЕНИЙ ОСИ Y (ИСПРАВЛЕНО: MatrixCells вместо Cells) -->
                <ItemsControl Grid.Column="0" ItemsSource="{Binding DataSource.BoundAxisY.MatrixCells}" Margin="0,0,2,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" Rows="{Binding DataSource.Rows}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252525" BorderBrush="#333333" BorderThickness="1" Margin="0,1">
                                <TextBlock Text="{Binding ValueText}" Foreground="#FFFF00" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,2"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                
                <!-- ОСНОВНАЯ КАЛИБРОВОЧНАЯ МАТРИЦА (Добавлено событие клика) -->
                <!-- ОСНОВНАЯ КАЛИБРОВОЧНАЯ МАТРИЦА (ИСПРАВЛЕНО: Чистый MVVM клик) -->
                <!-- ОСНОВНАЯ КАЛИБРОВОЧНАЯ МАТРИЦА (Клик на уровне всего контейнера сетки) -->
                <!-- ОСНОВНАЯ КАЛИБРОВОЧНАЯ МАТРИЦА (ЧИСТАЯ, БЕЗ ОШИБОК) -->
                <!-- ОСНОВНАЯ КАЛИБРОВОЧНАЯ МАТРИЦА (TextBox с привязкой Enter) -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding DataSource.MatrixCells}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding DataSource.Rows}" Columns="{Binding DataSource.Cols}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MatrixCellBorderStyle}" Margin="1">
                                <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                         Style="{StaticResource MatrixCellTextBoxStyle}">
                                    <TextBox.InputBindings>
                                        <!-- ВОЗВРАЩАЕМ В СТРОЙ КОМАНДУ ENTER: 
                                             При нажатии Enter вызывается SaveLayoutCommand, которая зафиксирует ввод,
                                             выключит режим IsEditing, отправит пакет в UART и вернет стрелочки! -->
                                        <KeyBinding Key="Enter" 
                                                    Command="{Binding DataContext.SaveLayoutCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Grid>
        </Grid>
    </DataTemplate>



    <!-- ==================== ВАРИАНТ 2: ГОРИЗОНТАЛЬНЫЙ ИНДИКАТОР УРОВНЯ (СЛАЙДЕР) ==================== -->
    <DataTemplate x:Key="WidgetSliderTemplate">
        <StackPanel VerticalAlignment="Center">
            <!-- Верхняя строка: Имя сигнала слева, текущее живое значение справа -->
            <Grid Margin="0,0,0,5">
                <TextBlock Text="{Binding DataSource.Name}" Foreground="#00E5FF" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding DataSource.CurrentValue, StringFormat='{}{0:F1}'}" Foreground="White" FontSize="14" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Индикатор уровня (Только для чтения, имитирует горизонтальный слайдер) -->
            <!-- Примечание: MinValue и MaxValue берутся из твоей VariableViewModel.Core.cs -->
            <ProgressBar Value="{Binding DataSource.CurrentValue}" 
                         Minimum="{Binding DataSource.MinValue}" 
                         Maximum="{Binding DataSource.MaxValue}" 
                         Height="16" Background="#111111" Foreground="#00E5FF" BorderThickness="1" BorderBrush="#333333"/>

            <TextBlock Text="{Binding DataSource.Comment}" Foreground="#555555" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="Consolas"/>
        </StackPanel>
    </DataTemplate>


    <!-- ==================== ВАРИАНТ 3: КРУГЛЫЙ СТРЕЛОЧНЫЙ ПРИБОР (GAUGE) ==================== -->
    <DataTemplate x:Key="WidgetGaugeTemplate">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="140" Height="140">
            <!-- Корпус прибора -->
            <Ellipse Stroke="#333333" StrokeThickness="2" Fill="#0D0D0D"/>
            <Ellipse Stroke="#00E5FF" StrokeThickness="1" Margin="4" StrokeDashArray="2,2"/>

            <!-- Шкала (Дуга фона) -->
            <Path Stroke="#222222" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 30,120 A 55,55 0 1 1 110,120"/>

            <!-- Живая заполняющаяся дуга (Привязана к значению через ProgressBar-логику или Arc) -->
            <!-- Для простоты и надежности выводим крупные цифры прямо в центр круга -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0">
                <TextBlock Text="{Binding DataSource.CurrentValue, StringFormat='{}{0:F1}'}" Foreground="#00FF00" FontSize="22" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DataSource.Name}" Foreground="#888888" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Физическая стрелка прибора (Вращается вокруг центра) -->
            <!-- С помощью встроенного в WPF RotateTransform мы превращаем float значение в угол поворота стрелки! -->
            <Rectangle Width="4" Height="45" Fill="#FF3D00" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,25,0,0" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform>
                    <!-- Математика угла: Начинаем с -120 градусов (ноль на приборе) и шагаем в зависимости от значения -->
                    <RotateTransform Angle="{Binding DataSource.CurrentValue, ConverterParameter=-120, FallbackValue=-120}"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <!-- Центральная заглушка стрелки -->
            <Ellipse Width="10" Height="10" Fill="#FF3D00" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
