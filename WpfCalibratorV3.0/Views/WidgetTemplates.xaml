<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="clr-namespace:WpfCalibrator.ViewModels">

    <!-- Базовый стиль заголовков панелей -->
    <Style x:Key="LocalBlockHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFFF00"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <!-- 1. ШАБЛОН: Цифровой дисплей телеметрии (Чтение через DataSource) -->
    <DataTemplate x:Key="WidgetDigitalTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DataSource.Name}" Foreground="#00E5FF" FontSize="14" FontWeight="Bold" FontFamily="Consolas"/>
                <TextBlock Text="{Binding DataSource.Comment}" Foreground="#666666" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding DataSource.CurrentValue, StringFormat='{}{0:F2}'}" Foreground="#00E5FF" FontSize="26" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </Grid>
    </DataTemplate>

    <!-- 2. ШАБЛОН: Скалярный параметр (Редактирование через DataSource) -->
    <DataTemplate x:Key="ScalarTextBoxTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DataSource.Name}" Foreground="#00FF00" FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                <TextBlock Text="{Binding DataSource.Comment}" Foreground="#888888" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas"/>
            </StackPanel>
            <TextBox Grid.Column="1" Text="{Binding DataSource.CurrentValue, UpdateSourceTrigger=LostFocus}" 
                     Background="#222222" Foreground="White" BorderBrush="#555555" 
                     Padding="6" VerticalAlignment="Center" HorizontalContentAlignment="Center" FontSize="16" FontWeight="Bold" FontFamily="Consolas"/>
        </Grid>
    </DataTemplate>

    <!-- 3. ШАБЛОН: Многомерная таблица LUT (Сетка через DataSource.Cells) -->
    <DataTemplate x:Key="MatrixTableTemplate">
        <StackPanel>
            <Grid Margin="0,0,0,5">
                <TextBlock Text="{Binding DataSource.Name}" Foreground="#FF9100" FontSize="16" FontWeight="Bold" FontFamily="Consolas"/>
                <TextBlock Foreground="#FF9100" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Right">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Размерность: {0} x {1}">
                            <Binding Path="DataSource.Rows"/>
                            <Binding Path="DataSource.Cols"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>
            <TextBlock Text="{Binding DataSource.Comment}" Foreground="#A0A0A0" FontSize="12" Margin="0,0,0,8" FontFamily="Consolas"/>

            <!-- ItemsSource теперь смотрит строго в вашу коллекцию Cells из VariableViewModel.Cells.cs -->
            <ItemsControl ItemsSource="{Binding DataSource.Cells}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding DataSource.Rows}" Columns="{Binding DataSource.Cols}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:MatrixCellViewModel}">
                        <Border BorderBrush="#333333" BorderThickness="1" Background="#222222" Margin="1">
                            <TextBox Text="{Binding ValueText, UpdateSourceTrigger=LostFocus}" 
                                     Background="Transparent" Foreground="White" BorderThickness="0" 
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center" 
                                     Padding="6" FontSize="14" FontFamily="Consolas"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>
    <!-- ==================== ВАРИАНТ 2: ГОРИЗОНТАЛЬНЫЙ ИНДИКАТОР УРОВНЯ (СЛАЙДЕР) ==================== -->
    <DataTemplate x:Key="WidgetSliderTemplate">
        <StackPanel VerticalAlignment="Center">
            <!-- Верхняя строка: Имя сигнала слева, текущее живое значение справа -->
            <Grid Margin="0,0,0,5">
                <TextBlock Text="{Binding DataSource.Name}" Foreground="#00E5FF" FontSize="13" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding DataSource.CurrentValue, StringFormat='{}{0:F1}'}" Foreground="White" FontSize="14" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Индикатор уровня (Только для чтения, имитирует горизонтальный слайдер) -->
            <!-- Примечание: MinValue и MaxValue берутся из твоей VariableViewModel.Core.cs -->
            <ProgressBar Value="{Binding DataSource.CurrentValue}" 
                         Minimum="{Binding DataSource.MinValue}" 
                         Maximum="{Binding DataSource.MaxValue}" 
                         Height="16" Background="#111111" Foreground="#00E5FF" BorderThickness="1" BorderBrush="#333333"/>

            <TextBlock Text="{Binding DataSource.Comment}" Foreground="#555555" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" FontFamily="Consolas"/>
        </StackPanel>
    </DataTemplate>


    <!-- ==================== ВАРИАНТ 3: КРУГЛЫЙ СТРЕЛОЧНЫЙ ПРИБОР (GAUGE) ==================== -->
    <DataTemplate x:Key="WidgetGaugeTemplate">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="140" Height="140">
            <!-- Корпус прибора -->
            <Ellipse Stroke="#333333" StrokeThickness="2" Fill="#0D0D0D"/>
            <Ellipse Stroke="#00E5FF" StrokeThickness="1" Margin="4" StrokeDashArray="2,2"/>

            <!-- Шкала (Дуга фона) -->
            <Path Stroke="#222222" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Data="M 30,120 A 55,55 0 1 1 110,120"/>

            <!-- Живая заполняющаяся дуга (Привязана к значению через ProgressBar-логику или Arc) -->
            <!-- Для простоты и надежности выводим крупные цифры прямо в центр круга -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0">
                <TextBlock Text="{Binding DataSource.CurrentValue, StringFormat='{}{0:F1}'}" Foreground="#00FF00" FontSize="22" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding DataSource.Name}" Foreground="#888888" FontSize="11" FontFamily="Consolas" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Физическая стрелка прибора (Вращается вокруг центра) -->
            <!-- С помощью встроенного в WPF RotateTransform мы превращаем float значение в угол поворота стрелки! -->
            <Rectangle Width="4" Height="45" Fill="#FF3D00" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,25,0,0" RenderTransformOrigin="0.5,1">
                <Rectangle.RenderTransform>
                    <!-- Математика угла: Начинаем с -120 градусов (ноль на приборе) и шагаем в зависимости от значения -->
                    <RotateTransform Angle="{Binding DataSource.CurrentValue, ConverterParameter=-120, FallbackValue=-120}"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <!-- Центральная заглушка стрелки -->
            <Ellipse Width="10" Height="10" Fill="#FF3D00" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0"/>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
