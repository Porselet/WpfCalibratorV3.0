<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="clr-namespace:WpfCalibrator.ViewModels">


    <!-- ====================================================================== -->
    <!-- ГЛОБАЛЬНЫЕ СТИЛИ (Компилируются в первую очередь, видны всем шаблонам) -->
    <!-- ====================================================================== -->
    <!-- ВОССТАНОВЛЕНИЕ: Стиль для заголовков блоков левого дерева переменных TreeView -->
    <Style x:Key="LocalBlockHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFA500"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="5,5,5,2"/>
    </Style>
    <!-- 1. СТИЛЬ ДЛЯ РАМОК ЯЧЕЕК ТАБЛИЦЫ С ПОДДЕРЖКОЙ КУРСОРНОГО ВЫДЕЛЕНИЯ -->
    <Style x:Key="MatrixCellBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="#222222"/>
        <Setter Property="BorderBrush" Value="#444444"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <!-- Живой неоновый прицел режимной точки двигателя -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="#00FF00"/>
                <Setter Property="BorderBrush" Value="#00FF00"/>
            </DataTrigger>

            <!-- Синий курсор выделения ячейки инженером -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="#007ACC"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>

            <!-- КОМБО! Если курсор навигации совпал с живым прицелом мотора -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsActive}" Value="True"/>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#00FF00"/>
                <Setter Property="BorderBrush" Value="#007ACC"/>
                <Setter Property="BorderThickness" Value="2"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- 2. СТИЛЬ ДЛЯ ТЕКСТА ВНУТРИ ЯЧЕЕК С АВТОФОКУСОМ (MoTeC-Style) -->
    <Style x:Key="MatrixCellTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <!-- Жирный черный текст на неоновом фоне режимной точки -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>

            <!-- МАГИЯ АВТОФОКУСА: TextBox принудительно забирает фокус ввода -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding Parent.IsEditing}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FocusManager.FocusedElement" Value="{Binding RelativeSource={RelativeSource Self}}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
    <!-- ====================================================================== -->
    <!-- ВИЗУАЛЬНЫЕ ШАБЛОНЫ ПРИБОРОВ (ЧИТАЮТ СТИЛИ СВЕРХУ СТАБИЛЬНО) -->
    <!-- ====================================================================== -->

    <!-- ШАБЛОН ОДИНОЧНОГО ПАРАМЕТРА (СКАЛЯРА С ПОДДЕРЖКОЙ РЕСАЙЗА) -->
    <DataTemplate x:Key="ScalarTextBoxTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Задаем базовые пропорции, от которых Viewbox будет увеличивать контент -->
                <Grid Width="260" Height="110">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Текст названия параметра -->
                    <TextBlock Grid.Column="0" 
                               Text="{Binding DataSource.Name}" 
                               Foreground="#00FF00" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               FontFamily="Consolas" 
                               VerticalAlignment="Center" 
                               Margin="10,0"/>

                    <!-- Поле ввода TextBox -->
                    <TextBox Grid.Column="1" 
                             Text="{Binding DataSource.CurrentValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                             Background="#222222" 
                             Foreground="White" 
                             FontFamily="Consolas" 
                             FontSize="22" 
                             Width="120" 
                             Height="36" 
                             VerticalAlignment="Center" 
                             HorizontalContentAlignment="Center" 
                             VerticalContentAlignment="Center" 
                             Margin="10,0"/>
                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>
    <!-- ШАБЛОН 3D-ТАБЛИЦЫ (ВЕКТОРНЫЙ И ЧИСТЫЙ) -->
    <DataTemplate x:Key="MatrixTableTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid Width="500" Height="280">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ШАПКА ТАБЛИЦЫ -->
                    <Grid Grid.Row="0" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DataSource.Name}" Foreground="#FFA500" FontWeight="Bold" FontSize="16" Margin="0,0,10,0" FontFamily="Consolas"/>
                            <TextBlock Foreground="Gray" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="Размерность: {0} x {1}">
                                        <Binding Path="DataSource.Rows"/>
                                        <Binding Path="DataSource.Cols"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <Button Content="⚙" 
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Width="24" Height="20"
                                Background="#333333" Foreground="#FFA500" FontWeight="Bold" 
                                BorderThickness="1" BorderBrush="#555555" Cursor="Hand"
                                Command="{Binding DataContext.OpenTableSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                    </Grid>

                    <!-- ВЫВОД ЗНАЧЕНИЙ ОСИ X -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding DataSource.BoundAxisX.MatrixCells}" Margin="35,0,0,2">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="{Binding DataSource.Cols}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#252525" BorderBrush="#333333" BorderThickness="1" Margin="1,0">
                                    <TextBlock Text="{Binding ValueText}" Foreground="#FFFF00" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- НИЖНЯЯ ЗОНА: ОСЬ Y И МАТРИЦА -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="35"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- ВЫВОД ЗНАЧЕНИЙ ОСИ Y -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding DataSource.BoundAxisY.MatrixCells}" Margin="0,0,2,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" Rows="{Binding DataSource.Rows}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#252525" BorderBrush="#333333" BorderThickness="1" Margin="0,1">
                                        <TextBlock Text="{Binding ValueText}" Foreground="#FFFF00" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4,2"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ОСНОВНАЯ КАЛИБРОВОЧНАЯ МАТРИЦА -->
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding DataSource.MatrixCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="{Binding DataSource.Rows}" Columns="{Binding DataSource.Cols}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Стили берутся из самого верха файла, всё стабильно! -->
                                    <Border Style="{StaticResource MatrixCellBorderStyle}" Margin="1">
                                        <TextBox Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" 
                                                 Style="{StaticResource MatrixCellTextBoxStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>

    <!-- ====================================================================== -->
    <!-- ВОССТАНОВЛЕНИЕ ОСТАЛЬНЫХ ШАБЛОНОВ ПРИБОРОВ (ЧТОБЫ УБРАТЬ ОШИБКИ)       -->
    <!-- ====================================================================== -->

    <!-- ШАБЛОН ЦИФРОВОГО ДАТЧИКА (Digital) -->
    <DataTemplate x:Key="WidgetDigitalTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform">
                <Grid Width="260" Height="110" Background="#151515">
                    <Border BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DataSource.Name}" Foreground="Gray" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding DataSource.CurrentValue, StringFormat={}{0:F1}}" Foreground="#007ACC" FontSize="28" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>

    <!-- ШАБЛОН СЛАЙДЕРА (Slider) -->
    <DataTemplate x:Key="WidgetSliderTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform">
                <Grid Width="260" Height="110" Background="#151515">
                    <Border BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="220">
                        <TextBlock Text="{Binding DataSource.Name}" Foreground="Gray" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <Slider Minimum="0" Maximum="100" Value="{Binding DataSource.CurrentValue}" IsEnabled="False"/>
                        <TextBlock Text="{Binding DataSource.CurrentValue, StringFormat={}{0:F1}}" Foreground="White" FontSize="16" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>

    <!-- ШАБЛОН СТРЕЛОЧНОГО ПРИБОРА (Gauge) -->
    <DataTemplate x:Key="WidgetGaugeTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform">
                <!-- Облегченная версия стрелочного индикатора MoTeC-style -->
                <Grid Width="180" Height="210" Background="#151515">
                    <Border BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3"/>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DataSource.Name}" Foreground="Gray" FontSize="12" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <Ellipse Width="80" Height="80" Stroke="#007ACC" StrokeThickness="3" Margin="0,10"/>
                        <TextBlock Text="{Binding DataSource.CurrentValue, StringFormat={}{0:F1}}" Foreground="White" FontSize="20" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </DataTemplate>


    <!-- ====================================================================== -->
    <!-- ФИНАЛЬНЫЙ ШАБЛОН АВИАЦИОННОГО ПРИЦЕЛА-РАДАРА (С ИСПРАВЛЕННЫМ ИМЕНЕМ)    -->
    <!-- ====================================================================== -->
    <!-- Ключ изменен строго на RadarTrackerTrackerTemplate для совпадения с триггером -->
    <DataTemplate x:Key="RadarTrackerTrackerTemplate">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎯 СУБСЕТОЧНЫЙ ПРИЦЕЛ: " Foreground="#007ACC" FontWeight="Bold" FontFamily="Consolas" FontSize="14"/>
                    <TextBlock Text="{Binding DataSource.Name}" Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="14"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#007ACC" BorderThickness="1" ClipToBounds="True">
                <Grid x:Name="RadarGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- СТАТИЧНЫЙ ЗЕЛЕНЫЙ ШАРИК-ЛИНЗА СТРОГО В ЦЕНТРЕ ОКНА -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="80" Height="80" Fill="#00FF00" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <BlurEffect Radius="20"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="30" Height="30" Stroke="#00FF00" StrokeThickness="2" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ЖИВОЕ ЯРКОЕ ПЕРЕКРЕСТИЕ ТЕКУЩЕГО СИГНАЛА С БЕСКОНЕЧНЫМИ ЛУЧАМИ -->
                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RenderTransform>
                                <TranslateTransform X="{Binding RadarGridOffsetX}" Y="{Binding RadarGridOffsetY}"/>
                            </Grid.RenderTransform>
                            <Path Stroke="#00FF00" StrokeThickness="2" Opacity="0.8" Data="M -1000,0 L 1000,0 M 0,-1000 L 0,1000"/>
                        </Grid>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>



<!-- ЗАЩИТНЫЙ ШАБЛОН ДЛЯ ПРЕДОТВРАЩЕНИЯ СБОЯ INVALIDCASTEXCEPTION -->
    <DataTemplate x:Key="EmptyFallbackTemplate">
        <Grid Background="Transparent"/>
    </DataTemplate>

</ResourceDictionary>
