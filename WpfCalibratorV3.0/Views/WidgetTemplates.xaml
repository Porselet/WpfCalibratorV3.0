                                <!-- ДИОДЫ 7-8: ОБЪЕМНЫЙ ЖЕЛТЫЙ СЕКТОР (ИСПРАВЛЕНО: Индексы 6 и 7) -->
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[6]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#FFFFD0" Offset="0"/>
                                                                <GradientStop Color="#FFFF00" Offset="0.5"/>
                                                                <GradientStop Color="#555500" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
