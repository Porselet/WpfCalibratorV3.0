                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[9]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#FFA0A0" Offset="0"/>
                                                                <GradientStop Color="#FF0000" Offset="0.5"/>
                                                                <GradientStop Color="#440000" Offset="0.95"/>
