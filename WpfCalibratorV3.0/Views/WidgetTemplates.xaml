    <!-- ====================================================================== -->
    <!-- ФИНАЛЬНЫЙ ШАБЛОН АВИАЦИОННОГО ПРИЦЕЛА-РАДАРА (С ИСПРАВЛЕННЫМ ИМЕНЕМ)    -->
    <!-- ====================================================================== -->
    <!-- Ключ изменен строго на RadarTrackerTrackerTemplate для совпадения с триггером -->
    <DataTemplate x:Key="RadarTrackerTrackerTemplate">
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎯 СУБСЕТОЧНЫЙ ПРИЦЕЛ: " Foreground="#007ACC" FontWeight="Bold" FontFamily="Consolas" FontSize="14"/>
                    <TextBlock Text="{Binding DataSource.Name}" Foreground="White" FontWeight="Bold" FontFamily="Consolas" FontSize="14"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#007ACC" BorderThickness="1" ClipToBounds="True">
                <Grid x:Name="RadarGrid" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                    <!-- СТАТИЧНЫЙ ЗЕЛЕНЫЙ ШАРИК-ЛИНЗА СТРОГО В ЦЕНТРЕ ОКНА -->
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="80" Height="80" Fill="#00FF00" Opacity="0.15" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <BlurEffect Radius="20"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Width="30" Height="30" Stroke="#00FF00" StrokeThickness="2" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- ЖИВОЕ ЯРКОЕ ПЕРЕКРЕСТИЕ ТЕКУЩЕГО СИГНАЛА С БЕСКОНЕЧНЫМИ ЛУЧАМИ -->
                    <Canvas HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.RenderTransform>
                                <TranslateTransform X="{Binding RadarGridOffsetX}" Y="{Binding RadarGridOffsetY}"/>
                            </Grid.RenderTransform>
                            <Path Stroke="#00FF00" StrokeThickness="2" Opacity="0.8" Data="M -1000,0 L 1000,0 M 0,-1000 L 0,1000"/>
                        </Grid>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>



    <!-- ШАБЛОН АВИАЦИОННОГО ГРАФИКА ВРЕМЕНИ (TimePlot / Осциллограф) -->
    <DataTemplate x:Key="WidgetTimePlotTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Окно осциллографа вытянуто по горизонтали (Ширина 220, Высота 110) -->
                <Grid Width="220" Height="110">

                    <!-- КОРПУС С ИНДИВИДУАЛЬНЫМ АЛАРМОМ НА УРОВНЕ ФОНА ЗАДНИКА -->
                    <Border x:Name="PlotBody" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#121212"/>
                                <!-- Глубокий черный фон экрана -->
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                            <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#770000"/>
                                        <!-- Приглушенный багровый аларм, чтобы линию было видно -->
                                        <Setter Property="BorderBrush" Value="#FF0000"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!-- Рабочая область отрисовки (зажимаем внутренний размер 200х100 под математику C#) -->
                        <Grid Margin="10,5" Width="200" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <!-- ТЕКСТОВОЕ ИМЯ ДАТЧИКА (Блеклый водяной знак на заднем плане) -->
                            <TextBlock Text="{Binding DataSource.Name}" Foreground="Gray" FontSize="11" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.3" Margin="5,5,0,0"/>

                            <!-- ЖИВАЯ ПОЛЗУЩАЯ ВЕКТОРНАЯ ЛИНИЯ ОСЦИЛЛОГРАФА -->
                            <!-- Биндим Points на нашу коллекцию PlotPoints из WidgetViewModel -->
                            <Polyline Points="{Binding PlotPoints}" StrokeThickness="2" StrokeLineJoin="Round">
                                <Polyline.Style>
                                    <Style TargetType="Polyline">
                                        <Setter Property="Stroke" Value="#007ACC"/>
                                        <!-- Неоново-синий MoTeC цвет линии -->
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                                    <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Stroke" Value="White"/>
                                                <!-- На красном фоне линия белеет для читаемости -->
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Polyline.Style>
                            </Polyline>
                            <!-- СИСТЕМА ГОРИЗОНТАЛЬНЫХ ПУНКТИРНЫХ ЛИНИЙ ЛИМИТОВ -->
                            <Canvas Width="200" Height="100" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">

                                <!-- ГОРИЗОНТАЛЬНЫЙ ПУНКТИР МИНИМАЛЬНОГО ЛИМИТА -->
                                <!-- Используем StrokeDashArray="4,4" для создания красивого авиационного пунктира -->
                                <Line X1="0" X2="200" 
                                      Y1="{Binding PlotMinLimitY}" Y2="{Binding PlotMinLimitY}" 
                                      Stroke="#FF3333" StrokeThickness="1" StrokeDashArray="4,4"/>

                                <!-- ГОРИЗОНТАЛЬНЫЙ ПУНКТИР МАКСИМАЛЬНОГО ЛИМИТА -->
                                <Line X1="0" X2="200" 
                                      Y1="{Binding PlotMaxLimitY}" Y2="{Binding PlotMaxLimitY}" 
                                      Stroke="#FF3333" StrokeThickness="1" StrokeDashArray="4,4"/>

                            </Canvas>

                        </Grid>
                        <!-- Закрываем внутренний Grid рабочей области 200х100 -->
                    </Border>
                    <!-- Закрываем корпус Border -->
                </Grid>
                <!-- Закрываем Grid фиксированного размера 220x110 -->
            </Viewbox>
            <!-- Закрываем масштабируемый Viewbox -->
        </Grid>
        <!-- Закрываем базовый Grid отступа -->
    </DataTemplate>
    <!-- Полностью закрываем шаблон осциллографа -->



    <!-- ИНТЕРАКТИВНЫЙ 3D-ШАБЛОН С КРУТЯЩЕЙСЯ КАМЕРОЙ И БИЛБОРД-ПОДПИСЯМИ -->
    <DataTemplate x:Key="Matrix3DSurfaceTemplate">
        <Grid Background="#222222">

            <!-- Свободное вращение (правая кнопка мыши), зум (колесо) и панорамирование -->
            <helix:HelixViewport3D x:Name="SurfaceViewport" 
                               ShowCoordinateSystem="False"
                               ShowViewCube="False"
                               IsRotationEnabled="True"
                               IsZoomEnabled="True"
                               IsPanEnabled="True">

                <!-- КАМЕРА ДЛЯ АЛГОРИТМИСТА: Развернута с обратной стороны, чтобы 0,0 была вверху слева. -->
                <!-- Фокус вращения (LookDirection) жестко привязан к центру измерительного куба -->
                <helix:HelixViewport3D.Camera>
                    <PerspectiveCamera  Position="-85,-115,85" 
                                        LookDirection="85,115,-75" 
                                        UpDirection="0,0,1" 
                                        FieldOfView="45"/>
                </helix:HelixViewport3D.Camera>

                <!-- Всеобщий фоновый свет без грязных теней на склонах -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <AmbientLight Color="#FFFFFF"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- 1. ТВЕРДОТЕЛЬНАЯ ПОВЕРХНОСТЬ КАРТЫ -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding DataSource.SurfaceMesh}">

                            <!-- 1. ЛИЦЕВОЙ МАТЕРИАЛ (Верх карты) -->
                            <GeometryModel3D.Material>
                                <DiffuseMaterial>
                                    <DiffuseMaterial.Brush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <!-- Пики - Приглушенный благородный бордово-красный -->
                                            <GradientStop Color="#C84B4B" Offset="0.0"/>
                                            <!-- Средне-высокие - Мягкий песочно-желтый -->
                                            <GradientStop Color="#D2B446" Offset="0.3"/>
                                            <!-- Середина - Матовый, спокойный травяной зеленый (Не слепит!) -->
                                            <GradientStop Color="#559664" Offset="0.6"/>
                                            <!-- Низкие и ямы - Глубокий, спокойный стальной сине-серый -->
                                            <GradientStop Color="#46648C" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </DiffuseMaterial.Brush>
                                </DiffuseMaterial>
                            </GeometryModel3D.Material>

                            <!-- 2. 🔥 ИЗНАНОЧНЫЙ МАТЕРИАЛ (Низ карты) -->
                            <!-- Сделали его точно таким же сочным, чтобы при любом вывороте осей Y карта сияла цветами! -->
                            <GeometryModel3D.BackMaterial>
                                <DiffuseMaterial>
                                    <DiffuseMaterial.Brush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <!-- Пики - Приглушенный благородный бордово-красный -->
                                            <GradientStop Color="#C84B4B" Offset="0.0"/>
                                            <!-- Средне-высокие - Мягкий песочно-желтый -->
                                            <GradientStop Color="#D2B446" Offset="0.3"/>
                                            <!-- Середина - Матовый, спокойный травяной зеленый (Не слепит!) -->
                                            <GradientStop Color="#559664" Offset="0.6"/>
                                            <!-- Низкие и ямы - Глубокий, спокойный стальной сине-серый -->
                                            <GradientStop Color="#46648C" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </DiffuseMaterial.Brush>
                                </DiffuseMaterial>
                            </GeometryModel3D.BackMaterial>

                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- 2. СЕТКА РЕБЕР НА ПОВЕРХНОСТИ (Четкие линии ячеек) -->
                <helix:LinesVisual3D Points="{Binding DataSource.SurfaceLines}" 
                                 Color="#111111" 
                                 Thickness="2.0"/>

                <!-- 3. ДИНАМИЧЕСКАЯ ИЗМЕРИТЕЛЬНАЯ КОРОБКА-ОБРЕШЕТКА -->
                <helix:LinesVisual3D Points="{Binding DataSource.BoundingBoxLines}" 
                                 Color="#888888" 
                                 Thickness="1.5"/>

                <!-- ==================== 4. ДИНАМИЧЕСКИЕ БИЛБОРД-ПОДПИСИ ШКАЛ И ОСЕЙ ==================== -->
                <!-- ==================== 4. ДИНАМИЧЕСКИЕ БИЛБОРД-ПОДПИСИ ОСЕЙ ==================== -->
                <!-- Главное название оси X (Обороты) -->
                <helix:BillboardTextVisual3D Position="0,-48,-3" 
                                         Text="{Binding DataSource.BoundAxisX.Name, FallbackValue='ОБОРОТЫ (RPM)'}" 
                                         Foreground="#FFFF00" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>

                <!-- Главное название оси Y (Нагрузка) -->
                <helix:BillboardTextVisual3D Position="48,0,-3" 
                                         Text="{Binding DataSource.BoundAxisY.Name, FallbackValue='НАГРУЗКА (%)'}" 
                                         Foreground="#FFFF00" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>

                <!-- Название текущей калибровочной карты Z -->
                <helix:BillboardTextVisual3D Position="45,45,34" 
                                         Text="{Binding DataSource.Name, FallbackValue='ЗНАЧЕНИЕ'}" 
                                         Foreground="#00FF00" FontSize="12" FontWeight="Bold" FontFamily="Consolas"/>


                <!-- ==================== 5. 🔥 АВТОСПОРТИВНАЯ ОЦИФРОВКА ШКАЛ (Паттерн Чистый XAML) ==================== -->
                <!-- Оцифровка уровней высоты куба Z (Оставляем аккуратные фиксированные билборды) -->
                <helix:BillboardTextVisual3D Position="39,39,0" Text="МИН" Foreground="#A0A0A0" FontSize="10" FontFamily="Consolas"/>
                <helix:BillboardTextVisual3D Position="39,39,7.5" Text="25%" Foreground="#A0A0A0" FontSize="10" FontFamily="Consolas"/>
                <helix:BillboardTextVisual3D Position="39,39,15" Text="50%" Foreground="#A0A0A0" FontSize="10" FontFamily="Consolas"/>
                <helix:BillboardTextVisual3D Position="39,39,22.5" Text="75%" Foreground="#A0A0A0" FontSize="10" FontFamily="Consolas"/>
                <helix:BillboardTextVisual3D Position="39,39,30" Text="МАКС" Foreground="#A0A0A0" FontSize="10" FontFamily="Consolas"/>

                <!-- 6. 🔥 ФИНАЛЬНЫЙ ВОЗВРАТ ЦИФР: Выводим список 3D-билбордов шкал из C# -->


                <!-- 2. 🔥 ОБЪЕМНЫЙ КИБЕРПАНК-ЛАЗЕР (Честный 3D-цилиндр) -->
                <!-- Биндимся на LaserBeamMesh, накладываем самосветящийся неоновый зеленый материал -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding DataSource.LaserBeamMesh}">
                            <GeometryModel3D.Material>
                                <MaterialGroup>
                                    <!-- Базовый матовый зеленый цвет для объема граней -->
                                    <DiffuseMaterial Brush="#00AA00"/>
                                    <!-- Мощное неоновое свечение, чтобы столб горел в темноте -->
                                    <EmissiveMaterial Brush="#00FF00"/>
                                </MaterialGroup>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- 3. ОБЪЕМНАЯ КРИСТАЛЛИЧЕСКАЯ РЕШЕТКА ВЕРШИН (Честные матовые сферы) -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding DataSource.AllSpheresMesh}">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial Brush="#2A3D54"/>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- 4. ГЛЯНЦЕВЫЙ НЕОНОВЫЙ КУРСОР ВЫДЕЛЕНИЯ (3D-Шары с бликами MoTeC-Style) -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding DataSource.SelectedSpheresMesh}">
                            <GeometryModel3D.Material>
                                <MaterialGroup>
                                    <DiffuseMaterial Brush="#0080FF"/>
                                    <SpecularMaterial Brush="#FFFFFF" SpecularPower="40"/>
                                </MaterialGroup>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>





            </helix:HelixViewport3D>
        </Grid>
    </DataTemplate>

    <!-- ОБНОВЛЕННЫЙ И СТАБИЛЬНЫЙ ШАБЛОН 3D-ПОВЕРХНОСТИ CHIPTUNINGPRO-STYLE -->
    <!-- СТАБИЛЬНЫЙ ШАБЛОН 3D-ПОВЕРХНОСТИ С ЦИФРОВЫМИ ШКАЛАМИ И ОСЯМИ -->
    <DataTemplate x:Key="Matrix3DSurfaceTemplateOLD">
        <Grid Background="#222222">

            <helix:HelixViewport3D x:Name="SurfaceViewport" 
                               ShowCoordinateSystem="False"
                               ShowViewCube="False"
                               IsRotationEnabled="False"
                               IsZoomEnabled="False"
                               IsPanEnabled="False">

                <helix:HelixViewport3D.Camera>
                    <!-- Слегка скорректировали ракурс, чтобы размашистые подписи шкал гарантированно не обрезались -->
                    <PerspectiveCamera Position="90,-125,90" 
                                   LookDirection="-90,125,-80" 
                                   UpDirection="0,0,1" 
                                   FieldOfView="45"/>
                </helix:HelixViewport3D.Camera>

                <!-- Всеобщая подсветка, убирающая тени со склонов -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <AmbientLight Color="#FFFFFF"/>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- 1. ТВЕРДОТЕЛЬНАЯ ПОВЕРХНОСТЬ КАРТЫ -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <GeometryModel3D Geometry="{Binding DataSource.SurfaceMesh}">
                            <GeometryModel3D.Material>
                                <DiffuseMaterial>
                                    <DiffuseMaterial.Brush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FF0000" Offset="0.0"/>
                                            <GradientStop Color="#FF7F00" Offset="0.2"/>
                                            <GradientStop Color="#FFFF00" Offset="0.4"/>
                                            <GradientStop Color="#00FF00" Offset="0.6"/>
                                            <GradientStop Color="#00FFFF" Offset="0.8"/>
                                            <GradientStop Color="#0000FF" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </DiffuseMaterial.Brush>
                                </DiffuseMaterial>
                            </GeometryModel3D.Material>
                        </GeometryModel3D>
                    </ModelVisual3D.Content>
                </ModelVisual3D>

                <!-- 2. СЕТКА РЕБЕР НА ПОВЕРХНОСТИ (Четкие линии ячеек) -->
                <helix:LinesVisual3D Points="{Binding DataSource.SurfaceLines}" 
                                 Color="#111111" 
                                 Thickness="2.0"/>

                <!-- 3. ДИНАМИЧЕСКАЯ ИЗМЕРИТЕЛЬНАЯ КОРОБКА-ОБРЕШЕТКА -->
                <helix:LinesVisual3D Points="{Binding DataSource.BoundingBoxLines}" 
                                 Color="#888888" 
                                 Thickness="1.5"/>

                <!-- 4. 🔥 ПОДПИСИ ОСЕЙ И ШКАЛ: Железобетонный проброс готового 3D-контента напрямую из C# -->
                <!-- 4. ПРАВИЛЬНО: Подключаем 3D-модели надписей напрямую в трехмерную сцену через Content -->
                <ModelVisual3D Content="{Binding DataSource.AxisLabelsContainer}"/>


            </helix:HelixViewport3D>
        </Grid>
    </DataTemplate>






    <!-- ЗАЩИТНЫЙ ШАБЛОН ДЛЯ ПРЕДОТВРАЩЕНИЯ СБОЯ INVALIDCASTEXCEPTION -->
    <DataTemplate x:Key="EmptyFallbackTemplate">
        <Grid Background="Transparent"/>
    </DataTemplate>

</ResourceDictionary>
