                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[1]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[2]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[3]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[4]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[5]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
