<UserControl x:Class="WpfCalibrator.Views.WorkspaceCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Border Background="#111111" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="📝 РАБОЧАЯ ОБЛАСТЬ КАЛИБРОВКИ И МОНИТОРИНГА" Style="{StaticResource LocalBlockHeaderStyle}" Margin="10,5,0,10"/>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <!-- Background должен быть ОБЯЗАТЕЛЬНО, иначе Drop не сработает! -->
                <Canvas Background="#050505" Width="2000" Height="2000" AllowDrop="True" Drop="Canvas_Drop">

                    <!-- СЛОЙ ПАРАМЕТРОВ -->
                    <ItemsControl ItemsSource="{Binding ParameterVariables}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left, Mode=TwoWay}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top, Mode=TwoWay}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#555555" BorderThickness="1" CornerRadius="4" Background="#1E1E1E" Width="400" Margin="2">
                                    <StackPanel>
                                        <Border Background="#2D2D2D" Padding="6,4">
                                            <Grid>
                                                <TextBlock Text="{Binding Config.Name}" Foreground="#00E5FF" FontWeight="Bold" FontFamily="Consolas" FontSize="13"/>
                                                <Button Content="❌" Background="Transparent" Foreground="Red" BorderThickness="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <Border Padding="10">
                                            <ContentControl Content="{Binding}">
                                                <ContentControl.Style>
                                                    <Style TargetType="ContentControl">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource MatrixTableTemplate}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Config.TotalElements}" Value="1">
                                                                <Setter Property="ContentTemplate" Value="{StaticResource ScalarTextBoxTemplate}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ContentControl.Style>
                                            </ContentControl>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- СЛОЙ ТЕЛЕМЕТРИИ -->
                    <ItemsControl ItemsSource="{Binding TelemetryVariables}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left, Mode=TwoWay}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top, Mode=TwoWay}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#007ACC" BorderThickness="1" CornerRadius="4" Background="#111A24" Width="250" Margin="2">
                                    <StackPanel>
                                        <Border Background="#1C2A38" Padding="6,4">
                                            <Grid>
                                                <TextBlock Text="{Binding Config.Name}" Foreground="#00FF00" FontWeight="Bold" FontFamily="Consolas" FontSize="13"/>
                                                <Button Content="❌" Background="Transparent" Foreground="Red" BorderThickness="0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                        <Border Padding="10">
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WidgetDigitalTemplate}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Canvas>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
