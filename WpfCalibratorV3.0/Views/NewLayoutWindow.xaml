<Window x:Class="WpfCalibrator.Views.NewLayoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfCalibrator.Views"
        mc:Ignorable="d"
        Title="Новый экран" 
        Height="150" Width="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" 
        ResizeMode="NoResize"
        Background="#111111" 
        BorderBrush="#333333" 
        BorderThickness="2">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Поле ввода -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки -->
            </Grid.RowDefinitions>

            <!-- ЗАГОЛОВОК -->
            <TextBlock Grid.Row="0" 
                   Text="⚙ ВВЕДИТЕ НАЗВАНИЕ НОВОГО ЭКРАНА:" 
                   Foreground="#FFFF00" 
                   FontSize="14" 
                   FontWeight="Bold" 
                   FontFamily="Consolas" 
                   Margin="0,0,0,10"/>

            <!-- ПОЛЕ ВВОДА -->
            <TextBox Grid.Row="1" 
                 x:Name="LayoutNameInput"
                 Background="#222222" 
                 Foreground="White" 
                 BorderBrush="#00FF00" 
                 BorderThickness="1"
                 FontSize="16" 
                 FontFamily="Consolas" 
                 Padding="5" 
                 VerticalAlignment="Top"
                 MaxLength="30"/>

            <!-- КНОПКИ УПРАВЛЕНИЯ -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <!-- Кнопка ОК -->
                <Button Content="ОК" 
                    Width="80" Height="30" 
                    Background="#2E7D32" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    FontFamily="Consolas"
                    Margin="0,0,10,0"
                    IsDefault="True"
                    Click="OkButton_Click"/>

                <!-- Кнопка ОТМЕНА -->
                <Button Content="ОТМЕНА" 
                    Width="80" Height="30" 
                    Background="#C62828" 
                    Foreground="White" 
                    FontWeight="Bold" 
                    FontFamily="Consolas"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Window>

