<Window
    x:Class="WpfCalibrator.Views.TableSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Настройка привязок Look-Up таблицы"
    SizeToContent="Height"
    Width="450"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="#111111"
    BorderBrush="#FF9100"
    BorderThickness="2">


    <Window.Resources>

        <Style
            x:Key="DarkButtonStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="#3E3E42" />
            <Setter
                Property="Foreground"
                Value="White" />
            <Setter
                Property="BorderBrush"
                Value="#555555" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="10,2" />
            <Setter
                Property="FontFamily"
                Value="Consolas" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Эффект наведения мыши (MouseOver) -->
                <Trigger
                    Property="IsMouseOver"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="#2D2D30" />
                    <Setter
                        Property="BorderBrush"
                        Value="#007ACC" />
                    <!-- Неоновый синий фокус -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 2. ТЕМНЫЙ СТИЛЬ ДЛЯ ТЕКСТОВЫХ ПОЛЕЙ (Шаги / Лимиты шкал) -->
        <Style
            x:Key="DarkTextBoxStyle"
            TargetType="TextBox">
            <Setter
                Property="Background"
                Value="#252526" />
            <Setter
                Property="Foreground"
                Value="#00FF00" />
            <!-- Зеленый мотековский шрифт! -->
            <Setter
                Property="BorderBrush"
                Value="#434346" />
            <Setter
                Property="CaretBrush"
                Value="White" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="4,2" />
            <Setter
                Property="FontFamily"
                Value="Consolas" />
            <Setter
                Property="FontWeight"
                Value="Bold" />
        </Style>



        <!-- ЕДИНСТВЕННЫЙ УНИВЕРСАЛЬНЫЙ ТЕМНЫЙ СТИЛЬ ДЛЯ ВСЕХ КОМБОБОКСОВ В ОКНЕ -->
        <!-- ПОЛНЫЙ ТЕМНЫЙ СТИЛЬ КОМБОБОКСА С ЗАЩИТОЙ ОТ БЕЛОГО ФОНА WINDOWS -->
    </Window.Resources>


    <Grid
        Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <!-- Заголовок -->
            <RowDefinition
                Height="Auto" />
            <!-- Поля настроек -->
            <RowDefinition
                Height="Auto" />
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- ЗАГОЛОВОК С ИМЕНЕМ ТАБЛИЦЫ -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Margin="0,0,0,15">
            <TextBlock
                Text="📋 НАСТРОЙКА КАРТЫ: "
                Foreground="White"
                FontSize="14"
                FontFamily="Consolas" />
            <TextBlock
                x:Name="TableNameText"
                Text="TEST_Data"
                Foreground="#FF9100"
                FontSize="14"
                FontWeight="Bold"
                FontFamily="Consolas" />
        </StackPanel>

        <!-- СЕТКА С ВЫБОРОМ ПЕРЕМЕННЫХ -->
        <!-- ЦЕНТРАЛЬНЫЙ ВЕРТИКАЛЬНЫЙ КОНТЕЙНЕР НАСТРОЕК (ЗАМЕНЯЕТ СТАРУЮ GRID) -->
        <StackPanel
            x:Name="MainSettingsPanel"
            Orientation="Vertical"
            Grid.Row="1"
            Margin="20,10,20,10">

            <!-- Строка 1: Выбор стиля/типа виджета (ВИДИМА ВСЕГДА) -->
            <StackPanel
                x:Name="Row_WidgetStyle"
                Orientation="Horizontal"
                Margin="0,0,0,10">
                <TextBlock
                    Text="Вид виджета:"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <ComboBox
                    x:Name="ComboStyle"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Type" />
            </StackPanel>

            <!-- Строка 2: Первый (основной) сигнал Канала 1. По умолчанию скрыта! -->
            <StackPanel
                x:Name="Row_InputX"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Сигнал / Канал 1:"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <ComboBox
                    x:Name="ComboInputX"
                    Width="250"
                    Height="24"
                    VerticalAlignment="Center"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- Строка 3: ВТОРОЙ СИГНАЛ (Для нашего TimePlot графика!). По умолчанию скрыта! -->
            <StackPanel
                x:Name="Row_InputY2"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Сигнал Канала 2:"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <ComboBox
                    x:Name="ComboInputY2"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- Строка 4: Привязка оси X (Для оцифровки шкал матриц) -->
            <StackPanel
                x:Name="Row_AxisX"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Ось X (Обороты):"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <ComboBox
                    x:Name="ComboAxisX"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- Строка 5: Привязка оси Y (Для оцифровки шкал матриц) -->
            <StackPanel
                x:Name="Row_AxisY"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Ось Y (Нагрузка):"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <ComboBox
                    x:Name="ComboAxisY"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- Строка 6: Входной сигнал Y (Для тяжелых 3D матриц) -->
            <StackPanel
                x:Name="Row_InputY"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Сигнал оси Y:"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <ComboBox
                    x:Name="ComboInputY"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>
            <!-- Строка 7: Шаг изменения по PageUp/PageDown -->
            <StackPanel
                x:Name="Row_IncrementStep"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Шаг изменения:"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <TextBox
                    x:Name="TextIncrementStep"
                    Width="100"
                    Style="{StaticResource DarkTextBoxStyle}" />
            </StackPanel>

            <!-- Строка 8: Границы физической шкалы прибора (ScaleMin и ScaleMax) -->
            <StackPanel
                x:Name="Row_ScaleRange"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Шкала (Мин / Макс):"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <TextBox
                    x:Name="TextScaleMin"
                    Width="70"
                    Style="{StaticResource DarkTextBoxStyle}"
                    Margin="0,0,10,0" />
                <TextBox
                    x:Name="TextScaleMax"
                    Width="70"
                    Style="{StaticResource DarkTextBoxStyle}" />
            </StackPanel>

            <!-- Строка 9: Аварийные границы (AlarmMin и AlarmMax) -->
            <StackPanel
                x:Name="Row_AlarmRange"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Алармы (Мин / Макс):"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <TextBox
                    x:Name="TextMinLimit"
                    Width="70"
                    Style="{StaticResource DarkTextBoxStyle}"
                    Margin="0,0,10,0" />
                <TextBox
                    x:Name="TextMaxLimit"
                    Width="70"
                    Style="{StaticResource DarkTextBoxStyle}" />
            </StackPanel>

            <!-- Строка 10: Ориентация прибора (Для 1D слайдеров) -->
            <StackPanel
                x:Name="Row_Orientation"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Ориентация:"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <RadioButton
                    x:Name="RadioHorizontal"
                    Content="Горизонтально"
                    Foreground="White"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center" />
                <RadioButton
                    x:Name="RadioVertical"
                    Content="Вертикально"
                    Foreground="White"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Строка 11: Чекбоксы опций Радара и 3D-поверхности Helix -->
            <StackPanel
                x:Name="Row_TableOptions"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Visibility="Collapsed">
                <TextBlock
                    Text="Опции отображения:"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <CheckBox
                    x:Name="CheckShowRadar"
                    Content="Сетка радара"
                    Foreground="White"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center" />
                <CheckBox
                    x:Name="CheckShow3D"
                    Content="3D Сцена"
                    Foreground="White"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Строка 12: Режим визуальной тревоги (Окрашивание фона датчика) -->
            <StackPanel
                x:Name="Row_VisualAlarm"
                Orientation="Horizontal"
                Margin="0,0,0,15"
                Visibility="Collapsed">
                <TextBlock
                    Text="Визуальный аларм:"
                    Width="150"
                    Foreground="Gray"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontFamily="Consolas" />
                <CheckBox
                    x:Name="CheckEnableVisualAlarm"
                    Content="Включить вспышку при аварии"
                    Foreground="White"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- КНОПКИ УПРАВЛЕНИЯ ОКНОМ НАСТРОЕК (СОХРАНИТЬ / ОТМЕНА) -->

        </StackPanel>
        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,10,0,0"
            Grid.Row="2">
            <Button
                x:Name="ButtonApply"
                Content="Применить"
                Width="100"
                Height="28"
                Margin="0,0,10,0"
                Style="{StaticResource DarkButtonStyle}"
                Click="ButtonApply_Click" />
            <Button
                x:Name="ButtonCancel"
                Content="Отмена"
                Width="100"
                Height="28"
                Style="{StaticResource DarkButtonStyle}"
                Click="ButtonCancel_Click" />
        </StackPanel>

    </Grid>
</Window>
