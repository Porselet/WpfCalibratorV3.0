<Window
    x:Class="WpfCalibrator.Views.TableSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Настройка привязок Look-Up таблицы"
    SizeToContent="Height"
    Width="450"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    ResizeMode="NoResize"
    Background="#111111"
    BorderBrush="#FF9100"
    BorderThickness="2">


    <Window.Resources>

        <Style
            x:Key="DarkButtonStyle"
            TargetType="Button">
            <Setter
                Property="Background"
                Value="#3E3E42" />
            <Setter
                Property="Foreground"
                Value="White" />
            <Setter
                Property="BorderBrush"
                Value="#555555" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="10,2" />
            <Setter
                Property="FontFamily"
                Value="Consolas" />
            <Setter
                Property="Template">
                <Setter.Value>
                    <ControlTemplate
                        TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Эффект наведения мыши (MouseOver) -->
                <Trigger
                    Property="IsMouseOver"
                    Value="True">
                    <Setter
                        Property="Background"
                        Value="#2D2D30" />
                    <Setter
                        Property="BorderBrush"
                        Value="#007ACC" />
                    <!-- Неоновый синий фокус -->
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 2. ТЕМНЫЙ СТИЛЬ ДЛЯ ТЕКСТОВЫХ ПОЛЕЙ (Шаги / Лимиты шкал) -->
        <Style
            x:Key="DarkTextBoxStyle"
            TargetType="TextBox">
            <Setter
                Property="Background"
                Value="#252526" />
            <Setter
                Property="Foreground"
                Value="#00FF00" />
            <!-- Зеленый мотековский шрифт! -->
            <Setter
                Property="BorderBrush"
                Value="#434346" />
            <Setter
                Property="CaretBrush"
                Value="White" />
            <Setter
                Property="BorderThickness"
                Value="1" />
            <Setter
                Property="Padding"
                Value="4,2" />
            <Setter
                Property="FontFamily"
                Value="Consolas" />
            <Setter
                Property="FontWeight"
                Value="Bold" />
        </Style>
        <!-- Стиль-сократитель для подписей (Лейблов) -->
        <Style
            x:Key="RowLabelStyle"
            TargetType="TextBlock">
            <Setter
                Property="Width"
                Value="150" />
            <Setter
                Property="Foreground"
                Value="Gray" />
            <Setter
                Property="VerticalAlignment"
                Value="Center" />
            <Setter
                Property="FontSize"
                Value="12" />
            <Setter
                Property="FontFamily"
                Value="Consolas" />
        </Style>

        <!-- Стиль-сократитель для горизонтальных строк контейнеров -->
        <Style
            x:Key="RowContainerStyle"
            TargetType="StackPanel">
            <Setter
                Property="Orientation"
                Value="Horizontal" />
            <Setter
                Property="Margin"
                Value="0,0,0,10" />
            <Setter
                Property="Visibility"
                Value="Collapsed" />
            <!-- Скрыты по умолчанию! -->
        </Style>



        <!-- ЕДИНСТВЕННЫЙ УНИВЕРСАЛЬНЫЙ ТЕМНЫЙ СТИЛЬ ДЛЯ ВСЕХ КОМБОБОКСОВ В ОКНЕ -->
        <!-- ПОЛНЫЙ ТЕМНЫЙ СТИЛЬ КОМБОБОКСА С ЗАЩИТОЙ ОТ БЕЛОГО ФОНА WINDOWS -->
    </Window.Resources>


    <Grid
        Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <!-- Заголовок -->
            <RowDefinition
                Height="Auto" />
            <!-- Умное Auto для динамического сжатия окна [1.22] -->
            <RowDefinition
                Height="Auto" />
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <!-- Строка 0: Текстовый заголовок окна калибратора -->
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Margin="0,0,0,15">
            <TextBlock
                Text="📋 НАСТРОЙКА ВИДЖЕТА: "
                Foreground="White"
                FontSize="14"
                FontFamily="Consolas"
                FontWeight="Bold" />
        </StackPanel>

        <!-- СТРОКА 1: ЦЕНТРАЛЬНЫЙ КОНТЕЙНЕР НАСТРОЕК (ПРИВЯЗАН К GRID.ROW="1") -->
        <StackPanel
            x:Name="MainSettingsPanel"
            Grid.Row="1"
            Orientation="Vertical">

            <!-- 1. Выбор стиля (Видим всегда, поэтому Visibility переопределен) [1.22] -->
            <StackPanel
                x:Name="Row_ComboBox_WidgetGeometry_ScalarSignalVisualComponentStyleType"
                Style="{StaticResource RowContainerStyle}"
                >
                <TextBlock
                    Text="Вид виджета:"
                    Style="{StaticResource RowLabelStyle}" />
                <ComboBox
                    x:Name="ComboBox_WidgetGeometry_ScalarSignalVisualComponentStyleType"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="DisplayName"
                    SelectedValuePath="Type" />
            </StackPanel>

            <!-- 2. Сигнал Канала 1 для Графика -->
            <StackPanel
                x:Name="Row_ComboBox_GraphPlot_TelemetrySignalChannel1Source"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Сигнал Канала 1:"
                    Style="{StaticResource RowLabelStyle}" />
                <ComboBox
                    x:Name="ComboBox_GraphPlot_TelemetrySignalChannel1Source"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- 3. Сигнал Канала 2 для Графика -->
            <StackPanel
                x:Name="Row_ComboBox_GraphPlot_TelemetrySignalChannel2Source"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Сигнал Канала 2:"
                    Style="{StaticResource RowLabelStyle}" />
                <ComboBox
                    x:Name="ComboBox_GraphPlot_TelemetrySignalChannel2Source"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- 4. Рабочий сигнал оси X для Таблиц -->
            <StackPanel
                x:Name="Row_ComboBox_CalibrationTable_TelemetrySignalHorizontalAxisXSource"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Сигнал оси X:"
                    Style="{StaticResource RowLabelStyle}" />
                <ComboBox
                    x:Name="ComboBox_CalibrationTable_TelemetrySignalHorizontalAxisXSource"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- 5. Вектор-шкала оцифровки горизонтальной оси X -->
            <StackPanel
                x:Name="Row_ComboBox_CalibrationTable_HorizontalScaleBreakpointLut"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Ось X (Обороты):"
                    Style="{StaticResource RowLabelStyle}" />
                <ComboBox
                    x:Name="ComboBox_CalibrationTable_HorizontalScaleBreakpointLut"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- 6. Рабочий сигнал оси Y для Таблиц (Только 3D) -->
            <StackPanel
                x:Name="Row_ComboBox_CalibrationTable_TelemetrySignalVerticalAxisYSource"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Сигнал оси Y:"
                    Style="{StaticResource RowLabelStyle}" />
                <ComboBox
                    x:Name="ComboBox_CalibrationTable_TelemetrySignalVerticalAxisYSource"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- 7. Вектор-шкала оцифровки вертикальной оси Y (Только 3D) -->
            <StackPanel
                x:Name="Row_ComboBox_CalibrationTable_VerticalScaleBreakpointLut"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Ось Y (Нагрузка):"
                    Style="{StaticResource RowLabelStyle}" />
                <ComboBox
                    x:Name="ComboBox_CalibrationTable_VerticalScaleBreakpointLut"
                    Width="250"
                    Style="{StaticResource DarkComboBoxStyle}"
                    DisplayMemberPath="Name" />
            </StackPanel>

            <!-- 8. Шаг изменения параметра с клавиатуры -->
            <StackPanel
                x:Name="Row_TextBox_CalibrationStep_KeyboardIncrementValue"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Шаг изменения:"
                    Style="{StaticResource RowLabelStyle}" />
                <TextBox
                    x:Name="TextBox_CalibrationStep_KeyboardIncrementValue"
                    Width="100"
                    Style="{StaticResource DarkTextBoxStyle}" />
            </StackPanel>

            <!-- 9. Границы прорисовки физической шкалы прибора -->
            <StackPanel
                x:Name="Row_ScaleRange"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Шкала (Мин/Макс):"
                    Style="{StaticResource RowLabelStyle}" />
                <TextBox
                    x:Name="TextBox_GraphicScale_MinimumDisplayBoundary"
                    Width="70"
                    Style="{StaticResource DarkTextBoxStyle}"
                    Margin="0,0,10,0" />
                <TextBox
                    x:Name="TextBox_GraphicScale_MaximumDisplayBoundary"
                    Width="70"
                    Style="{StaticResource DarkTextBoxStyle}" />
            </StackPanel>

            <!-- 10. Пороги срабатывания аварийных алармов -->
            <StackPanel
                x:Name="Row_AlarmRange"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Алармы (Мин/Макс):"
                    Style="{StaticResource RowLabelStyle}" />
                <TextBox
                    x:Name="TextBox_HardwareAlarm_CriticalMinimumThreshold"
                    Width="70"
                    Style="{StaticResource DarkTextBoxStyle}"
                    Margin="0,0,10,0" />
                <TextBox
                    x:Name="TextBox_HardwareAlarm_CriticalMaximumThreshold"
                    Width="70"
                    Style="{StaticResource DarkTextBoxStyle}" />
            </StackPanel>

            <!-- 11. Направление прорисовки 1D слайдеров -->
            <StackPanel
                x:Name="Row_Orientation"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Ориентация:"
                    Style="{StaticResource RowLabelStyle}" />
                <RadioButton
                    x:Name="RadioButton_WidgetLayout_HorizontalOrientation"
                    Content="Горизонтально"
                    Foreground="White"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center" />
                <RadioButton
                    x:Name="RadioButton_WidgetLayout_VerticalOrientation"
                    Content="Вертикально"
                    Foreground="White"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- 12. Флаги отрисовки Радара и 3D сцены Helix -->
            <StackPanel
                x:Name="Row_TableOptions"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Опции таблицы:"
                    Style="{StaticResource RowLabelStyle}" />
                <CheckBox
                    x:Name="CheckBox_UiRenderOptions_EnableNeonRadarTrackerTarget"
                    Content="Маркер прицела"
                    Foreground="White"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center" />
                <CheckBox
                    x:Name="CheckBox_UiRenderOptions_EnableHelix3DPolygonSurface"
                    Content="3D Рельеф Helix"
                    Foreground="White"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- 13. Чекбокс включения вспышки фона при аварии -->
            <StackPanel
                x:Name="Row_VisualAlarm"
                Style="{StaticResource RowContainerStyle}">
                <TextBlock
                    Text="Визуальный аларм:"
                    Style="{StaticResource RowLabelStyle}" />
                <CheckBox
                    x:Name="CheckBox_UiRenderOptions_EnableRedBackgroundEmergencyFlash"
                    Content="Мигать красным цветом при выходе за лимиты"
                    Foreground="White"
                    VerticalAlignment="Center" />
            </StackPanel>

        </StackPanel>

        <!-- СТРОКА 2: ФИКСИРОВАННЫЕ КНОПКИ УПРАВЛЕНИЯ (ПРИВЯЗАНЫ К GRID.ROW="2") [1.22] -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,15,0,0">
            <Button
                x:Name="ButtonApply"
                Content="Применить"
                Width="100"
                Height="28"
                Margin="0,0,10,0"
                Style="{StaticResource DarkButtonStyle}"
                Click="ButtonApply_Click" />
            <Button
                x:Name="ButtonCancel"
                Content="Отмена"
                Width="100"
                Height="28"
                Style="{StaticResource DarkButtonStyle}"
                Click="ButtonCancel_Click" />
        </StackPanel>
    </Grid>
</Window>
