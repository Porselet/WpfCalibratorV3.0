<UserControl x:Class="WpfCalibrator.Views.TreeViewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfCalibrator.Models">

    <Border Background="#111111" BorderBrush="#444444" BorderThickness="0,0,2,0" Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Строка 0: БЛОК УПРАВЛЕНИЯ COM-ПОРТОМ (Добавлен) -->
                <RowDefinition Height="Auto"/>
                <!-- Строка 1: Заголовок дерева моделей -->
                <RowDefinition Height="*"/>
                <!-- Строка 2: Дерево моделей -->
                <RowDefinition Height="Auto"/>
                <!-- Строка 3: Кнопки Flash / Экран -->
            </Grid.RowDefinitions>

            <!-- ==================== БЛОК СВЯЗИ С STM32 (UART) ==================== -->
            <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,20">
                <TextBlock Text="🔌 СВЯЗЬ С КОНТРОЛЛЕРОМ" Foreground="#00E5FF" FontSize="14" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <!-- Для ComboBox -->
                        <ColumnDefinition Width="1*"/>
                        <!-- Для Кнопки -->
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0" ItemsSource="{Binding AvailablePorts}" SelectedItem="{Binding SelectedPort}"
                        Style="{StaticResource DarkComboBoxStyle}">



                        <!-- СТИЛЬ СТРОК В ВЫПАДАЮЩЕМ СПИСКЕ: -->
                        
                    </ComboBox>


                    <!-- Кнопка "ПОДКЛЮЧИТЬ" (Вызывает твой метод ToggleConnection через ToggleConnectionCommand) -->
                    <Button Grid.Column="1" Content="СОЕДИНИТЬ" Command="{Binding ToggleConnectionCommand}"
                            Background="#007ACC" Foreground="White" BorderThickness="0" FontWeight="Bold" Padding="8,4" FontSize="12" FontFamily="Consolas"/>
                </Grid>

                <!-- Строка статуса (Выводит твою строку ConnectionStatusText: "СВЯЗЬ УСТАНОВЛЕНА" и т.д.) -->

                <!-- ====================================================================== -->
                <!-- АВТОСПОРТИВНЫЙ ИНДИКАТОР СТАТУСА СВЯЗИ С ЖЕЛЕЗОМ (BlackPill)          -->
                <!-- ====================================================================== -->
                <!-- ====================================================================== -->
                <!-- ОБНОВЛЕННЫЙ ВЕРТИКАЛЬНЫЙ ИНДИКАТОР СТАТУСА СВЯЗИ (КРУПНЫЙ ШРИФТ)       -->
                <!-- ====================================================================== -->
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,12,0,8">

                    <!-- Крупный физический светодиод (увеличили до 16x16 под стать шрифту) -->
                    <Ellipse Width="16" 
                     Height="16" 
                     HorizontalAlignment="Center"
                     Margin="0,0,0,10">
                        <Ellipse.Fill>
                            <Binding Path="DeviceStatusColor" FallbackValue="#FF3B30"/>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="8" 
                                      ShadowDepth="0" 
                                      Color="{Binding DeviceStatusColor, FallbackValue=#FF3B30}"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Крупная текстовая подпись с автоматическим переносом на 2 строки -->
                    <TextBlock Text="{Binding DeviceStatusText, FallbackValue=Отключено}" 
                       FontSize="22" 
                       FontWeight="SemiBold"
                       Foreground="#FFFFFF" 
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="220"
                       HorizontalAlignment="Center"/>

                </StackPanel>



                <!--<TextBlock Text="{Binding ConnectionStatusText}" Foreground="#FF9100" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Margin="0,8,0,0" TextWrapping="Wrap"/> -->
            </StackPanel>

            <!-- ==================== ДЕРЕВО НАВИГАЦИИ (СДВИГНУТО ВНИЗ) ==================== -->
            <TextBlock Grid.Row="1" Text="🌲 ДЕРЕВО МОДЕЛЕЙ" Style="{StaticResource LocalBlockHeaderStyle}" Margin="0,0,0,10"/>

            <TreeView Grid.Row="2" ItemsSource="{Binding DiscoveredDevices}" Background="#111111" BorderThickness="0">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="VariableNode_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="MouseMove" Handler="VariableNode_MouseMove"/>
                        <Setter Property="IsExpanded" Value="True"/>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type models:DeviceConfig}" ItemsSource="{Binding Models.Values}">
                        <TextBlock Text="{Binding DeviceName}" Foreground="#FFFF00" FontWeight="Bold" FontSize="15" Margin="2" FontFamily="Consolas"/>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type models:ModelConfig}" ItemsSource="{Binding TreeCategories}">
                        <TextBlock Text="{Binding ModelName}" Foreground="White" FontSize="15" Margin="2" FontFamily="Consolas"/>
                    </HierarchicalDataTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type models:TreeFolder}" ItemsSource="{Binding Items}">
                        <TextBlock Text="{Binding Name}" Foreground="#FFA500" FontWeight="Bold" FontSize="14" Margin="2" FontFamily="Consolas"/>
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type models:VariableConfig}">
                        <TextBlock Text="{Binding Name}" Foreground="#E0E0E0" FontSize="14" Margin="4,2,2,2" FontFamily="Consolas" Cursor="Hand" ToolTip="{Binding Comment}"/>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>

            <!-- Кнопки управления в самом низу левой панели -->
            <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,15,0,0">
                <Button Content=" 💾 СОХРАНИТЬ ВО FLASH" 
                    Command="{Binding SaveToFlashCommand}"
                    FontSize=" 16" 
                    Background="#2E7D32" 
                    Foreground=" White" 
                    Padding=" 12" 
                    Margin=" 0,0,0,10" 
                    FontFamily=" Consolas"/>



                <!-- Было: <Button Content="⚙ НАСТРОЙКА ЭКРАНА" ... /> -->
                <Button Content="💾 СОХРАНИТЬ ЭКРАН" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    Background="#7B1FA2" 
                    Margin="0,5,0,0" 
                    Height="40"
                    Command="{Binding SaveLayoutCommand}"/>


            </StackPanel>
        </Grid>
    </Border>
</UserControl>
