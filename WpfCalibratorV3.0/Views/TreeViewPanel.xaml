<UserControl x:Class="WpfCalibrator.Views.TreeViewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WpfCalibrator.Models">
    
    <Border Background="#111111" BorderBrush="#444444" BorderThickness="0,0,2,0" Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="🌲 ДЕРЕВО МОДЕЛЕЙ" Style="{StaticResource LocalBlockHeaderStyle}" Margin="0,0,0,15"/>

            <TreeView Grid.Row="1" ItemsSource="{Binding DiscoveredDevices}" Background="#111111" BorderThickness="0">

                <!-- СТИЛЬ ДЛЯ ВСЕХ УЗЛОВ ДЕРЕВА: Переносим события захвата мыши сюда -->
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <!-- Эти события сработают ВСЕГДА, независимо от того, куда кликнули -->
                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="VariableNode_PreviewMouseLeftButtonDown"/>
                        <EventSetter Event="MouseMove" Handler="VariableNode_MouseMove"/>
                        <!-- Делает узлы развернутыми по умолчанию (для удобства) -->
                        <Setter Property="IsExpanded" Value="True"/>
                    </Style>
                </TreeView.ItemContainerStyle>

                <TreeView.Resources>
                    <!-- Уровень 1: Физическое устройство -->
                    <HierarchicalDataTemplate DataType="{x:Type models:DeviceConfig}" ItemsSource="{Binding Models.Values}">
                        <TextBlock Text="{Binding DeviceName}" Foreground="#FFFF00" FontWeight="Bold" FontSize="15" Margin="2" FontFamily="Consolas"/>
                    </HierarchicalDataTemplate>

                    <!-- Уровень 2: Модель Simulink -->
                    <HierarchicalDataTemplate DataType="{x:Type models:ModelConfig}" ItemsSource="{Binding TreeCategories}">
                        <TextBlock Text="{Binding ModelName}" Foreground="White" FontSize="15" Margin="2" FontFamily="Consolas"/>
                    </HierarchicalDataTemplate>

                    <!-- Уровень 3: Виртуальные папки -->
                    <HierarchicalDataTemplate DataType="{x:Type models:TreeFolder}" ItemsSource="{Binding Items}">
                        <TextBlock Text="{Binding Name}" Foreground="#FFA500" FontWeight="Bold" FontSize="14" Margin="2" FontFamily="Consolas"/>
                    </HierarchicalDataTemplate>

                    <!-- Уровень 4: Конечный элемент (Убираем отсюда события, они теперь в ItemContainerStyle) -->
                    <DataTemplate DataType="{x:Type models:VariableConfig}">
                        <TextBlock Text="{Binding Name}" Foreground="#E0E0E0" FontSize="14" Margin="4,2,2,2" FontFamily="Consolas" Cursor="Hand" ToolTip="{Binding Comment}"/>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
            
            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,15,0,0">
                <Button Content="💾 СОХРАНИТЬ ВО FLASH" FontSize="16" FontWeight="Bold" Background="#2E7D32" Foreground="White" Padding="12" Margin="0,0,0,10" FontFamily="Consolas"/>
                <Button Content="⚙️ НАСТРОЙКА ЭКРАНА" FontSize="16" FontWeight="Bold" Background="#7B1FA2" Foreground="White" Padding="12" FontFamily="Consolas"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
