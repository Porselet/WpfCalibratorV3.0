<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:viewmodels="clr-namespace:WpfCalibrator.ViewModels">

    <!-- ====================================================================== -->
    <!-- СТИЛЬ ДЛЯ ЗАГОЛОВКОВ БЛОКОВ ЛЕВОГО ДЕРЕВА (TreeView)                   -->
    <!-- Задает фирменный оранжевый цвет, шрифт Consolas и плотные отступы для  -->
    <!-- читаемости названий категорий ("Параметры", "Телеметрия") в навигации. -->
    <!-- ====================================================================== -->

    <Style x:Key="LocalBlockHeaderStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#FFA500"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="5,5,5,2"/>
    </Style>
    
    <!-- ====================================================================== -->
    <!-- СТИЛЬ РАМОК ЯЧЕЕК ТАБЛИЦЫ (Border) С ТРИГГЕРАМИ И КУРСОРНЫМ ВЫДЕЛЕНИЕМ  -->
    <!-- 1. Задает жесткий минимум 45x22px для защиты тяжелых матриц от сжатия. -->
    <!-- 2. Включает неоновое зеленое окрашивание для живой режимной точки МК.  -->
    <!-- 3. Подсвечивает синим контуром текущую выбранную ячейку инженера.     -->
    <!-- ====================================================================== -->

    <Style x:Key="MatrixCellBorderStyle" TargetType="Border">
        <!-- Для 5х6 ячейки будут растягиваться, а для 32х32 никогда не сожмутся меньше этих цифр! -->
        <Setter Property="MinWidth" Value="45"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Background" Value="#222222"/>
        <Setter Property="BorderBrush" Value="#444444"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <!-- Живой неоновый прицел режимной точки двигателя -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Background" Value="#00FF00"/>
                <Setter Property="BorderBrush" Value="#00FF00"/>
            </DataTrigger>

            <!-- Синий курсор выделения ячейки инженером -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="#007ACC"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>

            <!-- КОМБО! Если курсор навигации совпал с живым прицелом мотора -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsActive}" Value="True"/>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="#00FF00"/>
                <Setter Property="BorderBrush" Value="#007ACC"/>
                <Setter Property="BorderThickness" Value="2"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ====================================================================== -->
    <!-- СТИЛЬ ДЛЯ ТЕКСТОВЫХ ПОЛЕЙ (TextBox) ВНУТРИ ЯЧЕЕК КАЛИБРОВОЧНЫХ ТАБЛИЦ -->
    <!-- 1. Делает фон прозрачным, а текст центрированным по MoTeC-стандарту.  -->
    <!-- 2. Инвертирует цвет текста в черный на зеленом фоне активной точки.    -->
    <!-- 3. Управляет автофокусом: принудительно забирает ввод при редактировании.-->
    <!-- ====================================================================== -->

    <Style x:Key="MatrixCellTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <!-- Жирный черный текст на неоновом фоне режимной точки -->
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="FontWeight" Value="Bold"/>
            </DataTrigger>

            <!-- МАГИЯ АВТОФОКУСА: TextBox принудительно забирает фокус ввода -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding Parent.IsEditing}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="FocusManager.FocusedElement" Value="{Binding RelativeSource={RelativeSource Self}}"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>