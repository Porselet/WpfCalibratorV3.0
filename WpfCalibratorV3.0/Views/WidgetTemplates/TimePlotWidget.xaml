<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helix="http://helix-toolkit.org/wpf"
    xmlns:viewmodels="clr-namespace:WpfCalibrator.ViewModels.WidgetViewModel">

    <!-- ШАБЛОН ДЛЯ ВЫСОКОСКОРОСТНОГО ИНЖЕНЕРНОГО ГРАФИКА-ОСЦИЛЛОГРАФА (TimePlot) -->
    <DataTemplate
        x:Key="TimePlotTemplate"
        DataType="{x:Type viewmodels:TimePlotWidgetViewModel}">
        <Grid
            Background="#1E1E1E">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>

            <!-- Шапка-легенда графика (показывает имена подключенных сигналов) -->
            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                Margin="10,5,10,0"
                VerticalAlignment="Center">
                <Ellipse
                    Width="10"
                    Height="10"
                    Fill="DeepSkyBlue"
                    Margin="0,0,5,0" />
                <TextBlock
                    Text="{Binding Signal1.Name, FallbackValue='Канал 1 (Не подключен)'}"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="11"
                    Margin="0,0,20,0" />

                <!-- Показываем легенду второго канала только если он физически выбран -->
                <!-- Показываем легенду второго канала только если он физически выбран -->
                <!-- Временно убираем скрытие, чтобы убрать ошибку XamlParseException -->
                <StackPanel
                    Orientation="Horizontal">
                    <Ellipse
                        Width="10"
                        Height="10"
                        Fill="OrangeRed"
                        Margin="0,0,5,0" />
                    <TextBlock
                        Text="{Binding Signal2.Name, FallbackValue='Канал 2 (Не подключен)'}"
                        Foreground="White"
                        FontWeight="Bold"
                        FontSize="11" />
                </StackPanel>


            </StackPanel>

            <!-- Главный 3D-конвейер рендеринга осциллографа -->
            <helix:HelixViewport3D
                Grid.Row="1"
                Margin="30,10,30,20"
                ShowCoordinateSystem="False"
                ShowViewCube="False"
                CameraRotationMode="Trackball"
                IsRotationEnabled="False"
                IsZoomEnabled="False"
                IsPanEnabled="False">

                <!-- Ортографическая камера для плоского 2D-вида (смотрим строго на плоскость XY) -->
                <helix:HelixViewport3D.Camera>
                    <OrthographicCamera
                        Position="5,50,50"
                        LookDirection="0,0,-1"
                        UpDirection="0,1,0"
                        Width="200" />
                </helix:HelixViewport3D.Camera>

                <!-- Стандартное освещение сцены -->
                <helix:DefaultLights />

                <!-- ИСПРАВЛЕНО: Задаем цвет сетки через стандартное свойство Fill -->
                <helix:GridLinesVisual3D
                    Width="10"
                    Length="100"
                    Center="5,50,0"
                    Fill="#333333"
                    Thickness="0.02" />


                <!-- 2. КАНАЛ 1: Живая сплошная линия (Синяя / DeepSkyBlue) -->
                <helix:LinesVisual3D
                    Points="{Binding StreamPoints1}"
                    Color="DeepSkyBlue"
                    Thickness="2.5" />

                <!-- 3. КАНАЛ 2: Живая сплошная линия (Красная / OrangeRed) -->
                <helix:LinesVisual3D
                    Points="{Binding StreamPoints2}"
                    Color="OrangeRed"
                    Thickness="2.5" />

                <!-- Линии алармов (сплошные, но полупрозрачные) -->
                <helix:LinesVisual3D
                    Points="{Binding AlarmMinPoints}"
                    Color="#66FF0000"
                    Thickness="2" />

                <helix:LinesVisual3D
                    Points="{Binding AlarmMaxPoints}"
                    Color="#66FF0000"
                    Thickness="2" />



                <!-- ДИНАМИЧЕСКИЙ КОНТЕЙНЕР ДЛЯ ЦИФР ШКАЛ Y1 и Y2 (Из нашего C# класса) -->
                <ModelVisual3D
                    Content="{Binding AxisLabelsContainer}" />

            </helix:HelixViewport3D>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
