<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:viewmodels="clr-namespace:WpfCalibrator.ViewModels">

    <!-- ====================================================================== -->
    <!-- ШАБЛОН СВЕТОДИОДНОГО БАРГРАФА (ИНДИКАТОР ИЗ 10 LED-ДИОДОВ)             -->
    <!-- 1. Имитирует профессиональную светодиодную линейку (как на рулях F1).  -->
    <!-- 2. Идеально подходит для критических параметров: варнинги детонации,   -->
    <!--    обороты переключения передач (Shift Light) или состав смеси (AFR).  -->
    <!-- 3. Динамически зажигает нужное количество диодов от зеленого до        -->
    <!--    красного цвета в зависимости от текущего уровня телеметрии в ОЗУ.   -->
    <!-- ====================================================================== -->


    <DataTemplate x:Key="WidgetArcGaugeTemplate">
        <Grid Margin="5">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <!-- Узкий компактный блок строго под размер LED-линейки -->
                <Grid Width="220" Height="35">

                    <!-- КОРПУС ПРИБОРА С АЛАРМОМ ФОНА -->
                    <Border x:Name="GaugeBody" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#151515"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataSource.IsAlarmActive}" Value="True"/>
                                            <Condition Binding="{Binding EnableVisualAlarm}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="#990000"/>
                                        <Setter Property="BorderBrush" Value="#FF0000"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!-- Центрируем линейку диодов по вертикали и горизонтали -->
                        <Grid Margin="15,0" VerticalAlignment="Center">
                            <!-- ЛИНЕЙКА ИЗ 10 КРУГЛЫХ СВЕТОДИОДОВ С ЗАЗОРАМИ -->
                            <UniformGrid Rows="1" Columns="10" Width="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <UniformGrid.Resources>
                                    <!-- Базовый стиль: выключенная контрастная стеклянная линза с ярким бликом -->
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Width" Value="11"/>
                                        <Setter Property="Height" Value="11"/>
                                        <Setter Property="Stroke" Value="#121212"/>
                                        <Setter Property="StrokeThickness" Value="1"/>
                                        <Setter Property="Margin" Value="3,0"/>
                                        <Setter Property="Fill">
                                            <Setter.Value>
                                                <RadialGradientBrush Center="0.3,0.3" RadiusX="0.6" RadiusY="0.6">
                                                    <GradientStop Color="#666666" Offset="0"/>
                                                    <GradientStop Color="#333333" Offset="0.5"/>
                                                    <GradientStop Color="#222222" Offset="0.95"/>
                                                </RadialGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </UniformGrid.Resources>

                                <!-- ДИОДЫ 1-6: ЗЕЛЕНЫЙ СЕКТОР (ИСПРАВЛЕНО: Индексы от 0 до 5) -->
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[0]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[1]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[2]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[3]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[4]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[5]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#A0FFA0" Offset="0"/>
                                                                <GradientStop Color="#00FF00" Offset="0.5"/>
                                                                <GradientStop Color="#004400" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- ДИОДЫ 7-8: ОБЪЕМНЫЙ ЖЕЛТЫЙ СЕКТОР (ИСПРАВЛЕНО: Индексы 6 и 7) -->
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[6]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#FFFFD0" Offset="0"/>
                                                                <GradientStop Color="#FFFF00" Offset="0.5"/>
                                                                <GradientStop Color="#555500" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[7]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#FFFFD0" Offset="0"/>
                                                                <GradientStop Color="#FFFF00" Offset="0.5"/>
                                                                <GradientStop Color="#555500" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                                <!-- ДИОДЫ 9-10: ОБЪЕМНЫЙ КРАСНЫЙ СЕКТОР (ИСПРАВЛЕНО: Индексы 8 и 9) -->
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[8]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#FFA0A0" Offset="0"/>
                                                                <GradientStop Color="#FF0000" Offset="0.5"/>
                                                                <GradientStop Color="#440000" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse" BasedOn="{StaticResource {x:Type Ellipse}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataSource.LedStates[9]}" Value="True">
                                                    <Setter Property="Fill">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.4,0.4" RadiusX="0.7" RadiusY="0.7">
                                                                <GradientStop Color="#FFA0A0" Offset="0"/>
                                                                <GradientStop Color="#FF0000" Offset="0.5"/>
                                                                <GradientStop Color="#440000" Offset="0.95"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>

                            </UniformGrid>
                            <!-- Закрываем сетку светодиодов -->

                        </Grid>
                        <!-- Закрываем внутренний Grid разметки -->
                    </Border>
                    <!-- Закрываем корпус Border -->
                </Grid>
                <!-- Закрываем Grid фиксированного размера 220x35 -->
            </Viewbox>
            <!-- Закрываем масштабируемый Viewbox -->
        </Grid>
        <!-- Закрываем базовый Grid отступа -->
    </DataTemplate>
    <!-- Полностью закрываем шаблон виджета -->

</ResourceDictionary>